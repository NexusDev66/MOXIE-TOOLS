# MOXIE · Next.js 环境变量模板
# 复制成 .env.local（已被 .gitignore 盖住）填上真值
# Vercel 部署在 Project Settings → Environment Variables 配

# ─── T2 入库 API: /api/internal/products (MOXIE-14) ───
# Bearer Token，长字符串 ≥ 64，仅服务端可见（不带 NEXT_PUBLIC_ 前缀）
# 生成：openssl rand -base64 48
LATEMAI_INTERNAL_TOKEN=your-64-char-bearer-token-here

# ─── Supabase（既有产品端使用） ───
NEXT_PUBLIC_SUPABASE_URL=https://sqvohgcwzhhsvkmyesvs.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# ─── T5 AI 补全: admin/candidates「AI 一键补全」(MOXIE-17) ───
# provider 二选一，默认 deepseek；只需配所选 provider 的 key
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# 切到 openai 时再配（LLM_PROVIDER=openai）
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
