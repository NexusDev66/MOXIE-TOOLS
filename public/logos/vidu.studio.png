ds\",\"fileTooLarge\":\"Audio file exceeds {maxMb} MB, please re-record\",\"nameDuplicate\":\"This name already exists. Please enter a different one.\",\"nameRequired\":\"Please enter voice name\"},\"voiceInfo\":{\"cancel\":\"Cancel\",\"confirm\":\"Confirm\",\"descriptionLabel\":\"Voice Description (Optional)\",\"descriptionPlaceholder\":\"Describe the voice characteristics\",\"dialogTitle\":\"Edit Info\",\"edit\":\"Edit voice info\",\"nameLabel\":\"Voice Name\",\"namePlaceholder\":\"Enter voice name\",\"previewLabel\":\"Custom Voice Preview\"}}},\"toolsHub\":{\"meta\":{\"description\":\"Discover every Vidu AI tool in one place: video editing, image generation, sound, voice and one-click production.\",\"title\":\"AI Tools - All Vidu Creators in One Place\"},\"subjectCreationTitle\":\"Character Generator\",\"subtitle\":\"One-stop multimodal creation. Bring ideas to life instantly and empower content production across all scenarios.\",\"title\":\"All-in-One AI Tools\"},\"tutorial\":{\"officialTutorial\":\"Official Tutorial\"},\"videoEditor\":{\"addCaption\":\"Add caption\",\"addHeading\":\"Add word art\",\"audioBatchPickMax\":\"Select at most {max} audio creations per batch.\",\"audioPropertiesTitle\":\"Audio\",\"audioUntitledPlaceholder\":\"Untitled audio\",\"backToShot\":\"Back\",\"backToShotAria\":\"Back to shot properties\",\"bgmLibraryAddAria\":\"Add “{name}” to the BGM track\",\"bgmLibraryFilterAll\":\"All\",\"bgmLibraryFilterEmpty\":\"No tracks match this style.\",\"bgmLibraryFilterRowAria\":\"Filter by music style\",\"bgmLibraryKeywords\":\"Keywords\",\"bgmLibraryMenu\":\"BGM library\",\"bgmLibraryPreviewAria\":\"Preview: {name}\",\"bgmLibraryScene\":\"Scene\",\"bgmLibraryStyle\":\"Style\",\"bgmLibraryStyles\":{\"blues\":\"Blues\",\"classical\":\"Classical\",\"country\":\"Country\",\"electronic\":\"Electronic\",\"film_score\":\"Film score\",\"funk\":\"Funk\",\"hip_hop\":\"Hip-hop\",\"house\":\"House\",\"orchestra\":\"Orchestra\",\"rock_roll\":\"Rock \u0026 rol