work error.\",\"phoneInvalid\":\"Please enter the correct phone number.\",\"resendExceeded\":\"You're making requests too quickly. Please try again in 3 minutes. Thanks for your patience!\",\"sendVerifyCodeError\":\"Failed to send verification code, please try again in 1 minute.\",\"unknownError\":\"Error while signing in.\"},\"footer\":\"By clicking \\\"Continue with Google,\\\" \\\"Continue with Apple,\\\" or \\\"Continue with Email,\\\" you confirm that you've read and agree to Vidu's \u003cterm\u003eTerms of Use\u003c/term\u003e and \u003cprivacy\u003ePrivacy Policy\u003c/privacy\u003e.\",\"googleLoginWarning\":\"WeChat browser does not support Google login, please use another browser or choose another login method.\",\"inviteCode\":{\"cardTitle\":\"Sign up with invitation code\",\"entrance\":\"Register with invitation code\",\"placeholder\":\"Enter invitation code (optional)\",\"title\":\"Invite Code\"},\"login\":\"Login/Register\",\"next\":\"Next\",\"phoneLogin\":\"Continue with Phone\",\"phonePlaceholder\":\"Phone number\",\"slogan\":\"What you imagine is what Vidu\",\"title\":\"Log in or sign up for free!\",\"visitorMode\":\"Visitor Login\"},\"loginGuideDialog\":{\"button\":\"Claim Now\",\"description\":\"More Surprises to Discover\",\"subtitle\":\"\u003ccredits\u003e\u003c/credits\u003e Credits For New Users\",\"t1Extra\":\"\u003ccredits\u003e\u003c/credits\u003e Credits Daily For Logging In\",\"title\":\"Just Log In to Claim\"},\"memberFission\":{\"copy\":\"Copy\",\"description\":\"Invite friends and earn shared rewards\",\"end\":\"Expired\",\"invitatCode\":{\"share\":\"Invite now\",\"step1\":\"Step 1\",\"step1Desc\":\"Copy the invitation code and send it to new users\",\"step2\":\"Step 2\",\"step2Desc\":\"New users need to fill in the invitation code to register\",\"step3\":\"Step 3\",\"step3Desc\":\"Both parties receive new user registration rewards\",\"step4\":\"Step 4\",\"step4Desc\":\"Invitees subscribe to membership\",\"step5\":\"Step 5\",\"step5Desc\":\"Both parties receive subscription rewards\",\"title\":\"Invitation Code\"},\"invitationRecord\":{\"invitees\":\"Invitees\",\"noRecord\":\"No Record\",\"registerRewards\":\"Registration Rewards\",\"registrationTime\":\"Registration Time\",\"subscribeRewards\":\"Subscription Rewards\",\"title\":\"Reward Records\",\"totalGrantCredit\":\"Total reward credits\",\"totalInviteCount\":\"New users invited\"},\"inviteChannelsDialog\":{\"description\":\"AI video made easy with Vidu. Use code {inviteCode} for bonus credits + new user perks! {viduLink}\",\"title\":\"AI video made easy with Vidu\"},\"loseEffect\":\"Expired\",\"questionsTitle\":\"Frequently Asked Questions\",\"rewardSystem\":{\"invitationCodeUseNum\":\"Invitation Code Usage Limit\",\"inviteeBenefits\":\"Invitee Benefits\",\"inviteeBenefitsDesc\":\"Your invitees get \u003cspan\u003e3\u003c/span\u003e days of free Standard trial\",\"newUserRegistration\":\"New User Registration Rewards\",\"newUserRegistrationDesc\":\"Both inviter and invitee receive \u003cspan\u003e100\u003c/span\u003e credits each\",\"subscriptionRewards\":\"Subscription Rewards\",\"subscriptionRewardsDesc_Premium\":\"2.The invitee subscribes to Premium plan: Both parties receive \u003cspan\u003e900\u003c/span\u003e credits each\",\"subscriptionRewardsDesc_Standard\":\"1.The invitee subscribes to Standard plan: Both parties receive \u003cspan\u003e300\u003c/span\u003e credits each\",\"subscriptionRewardsDesc_Ultimate\":\"3.The invitee subscribes to Ultimate plan: Both parties receive \u003cspan\u003e2000\u003c/span\u003e credits each\",\"title\":\"Reward System\"},\"title\":\"Vidu Booster\",\"welcome\":{\"description\":\"Hi {nickname}~ Every upgrade, every improvement—it all happens because of your support. Thank you for being part of our journey.\u003cbr\u003e\u003c/br\u003eNow, we’d love for you to help shape the future of Vidu by becoming a Vidu Booster. Share what you love. Invite your friends, family, or followers to try Vidu. They’ll get 100 bonus credits and 3 days of free Standard membership. When they subscribe, you both earn extra credits—a win-win.\u003cbr\u003e\u003c/br\u003eLet’s grow Vidu together 💜\",\"title\":\"You Make Vidu Better\"}},\"meta\":{\"agentProject\":{\"description\":\"Experience the powerful capabilities of Vidu Video Generation Agent. Integrating flexible canvas editing and conversational interaction, it generates long videos with voiceover dubbing via one-sentence commands—an AI-powered efficient video creation platform.\",\"title\":\"Vidu Agent\"},\"agentProjectShare\":{\"description\":\"Share the AI-generated videos you created with Vidu, exchange creative inspiration with creators around the world, and discover more wonderful AI creative ideas and tricks\",\"title\":\"Share your AI-Generated Video｜Vidu Agent\"},\"ai-ad-generator\":{\"description\":\"Create stunning video ads for free and grow your business! Upload product images, add prompts, and effortlessly generate video ads for promotions.\",\"title\":\"AI Video Ad Generator - Create Commercial Video Ads\"},\"ai-animation-generator\":{\"description\":\"Create animated videos from prompts and images with Vidu's AI animation generator for anime scenes, social content, and stylized motion.\",\"title\":\"AI Animation Generator for Text, Images \u0026 Anime Clips\"},\"ai-anime-video-generator\":{\"description\":\"Turn text or images into anime scenes with Vidu's image to animation converter and AI video generation workflow for fast stylized output.\",\"title\":\"Vidu AI Anime Video Generator - Turn Text or Image into Anime\"},\"ai-cartoon-video-generator\":{\"description\":\"Create cartoon videos from prompts or images with Vidu's AI cartoon video generator for stylized stories, social clips, and animated scenes.\",\"title\":\"AI Cartoon Video Generator from Text \u0026 Images\"},\"ai-dance-generator\":{\"description\":\"Create picture-to-dance videos with Vidu's AI dance generator and turn images into dance clips in just a few steps.\",\"title\":\"AI Dance Generator - Turn Images into Dance Videos\"},\"ai-fight-generator\":{\"description\":\"Create cinematic battle scenes with Vidu's AI video generator using text, image, or reference inputs for realistic and anime-style action.\",\"title\":\"Vidu AI Fight Generator for Realistic \u0026 Anime Battles\"},\"ai-hug-generator\":{\"description\":\"Create warm hug videos from photos with Vidu's AI hug generator and an AI video workflow that keeps characters consistent.\",\"title\":\"AI Hug Generator - Create AI Hug Videos Online\"},\"ai-image-animator\":{\"description\":\"Use Vidu as an image to animation converter to animate portraits, paintings, anime art, and old photos with natural motion.\",\"title\":\"Image to Animation Converter for Photos \u0026 Portraits\"},\"ai-image-generator\":{\"description\":\"Create images with Vidu AI image generator and editor. Text-to-Image and Reference-to-Image with 1080p/2K/4K output in just a few seconds.\",\"title\":\"AI Image Generator \u0026 Editor\"},\"ai-image-to-video\":{\"description\":\"Use Vidu to make video from photo inputs, turn images into videos, and create smooth cinematic motion from still images in seconds.\",\"title\":\"Make Video from Photo with Image to Video AI\"},\"ai-image-to-video-generator\":{\"description\":\"Turn photos into videos with Vidu AI without any skills. Use it now to animate your artwork or precious memories.\",\"title\":\"Image to Video AI Generator\"},\"ai-kissing-generator\":{\"description\":\"Create romantic kissing videos from photos with Vidu's AI kissing generator and an AI video workflow built for social posts and storytelling.\",\"title\":\"AI Kissing Generator - AI Kissing Video Creator\"},\"ai-meme-generator\":{\"description\":\"Create meme videos from prompts, images, or clips with Vidu's AI video generator for fast edits and social-ready output.\",\"title\":\"AI Meme Video Generator for Social Content\"},\"ai-reel-generator\":{\"description\":\"Generate stunning Instagram Reels using Vidu's AI Reel Generator. Create from text, images, or references with fast editing tools and versatile templates.\",\"title\":\"AI Reel Generator | Create Viral Videos for Instagram with Vidu\"},\"ai-reference-to-video\":{\"description\":\"Use Vidu as an AI video generator from image references to keep characters, objects, and scenes consistent across cinematic outputs.\",\"title\":\"AI Video Generator from Image with Multi-Reference Control\"},\"ai-sound-effect-generator\":{\"description\":\"Generate sound effects and music from text with Vidu's AI sound effect generator for creators, developers, and video sound design.\",\"title\":\"AI Sound Effect Generator - Text to Audio with AI\"},\"ai-templates\":{\"description\":\"Discover Vidu AI video templates for photo effects, viral edits, and social-ready videos you can create from a single image.\",\"title\":\"AI Video Templates for Photo Effects \u0026 Social Content\"},\"ai-text-to-video\":{\"description\":\"Turn prompts into scenes with Vidu, an AI video generator from text that helps creators move from idea to video faster.\",\"title\":\"AI Video Generator from Text\"},\"ai-text-to-video-generator\":{\"description\":\"Use Vidu's Text to Video AI Generator to create stunning videos effortlessly. Transform text into high-quality videos in minutes—no editing skills required!\",\"title\":\"Text to Video AI Generator\"},\"ai-tiktok-video-generator\":{\"description\":\"Use Vidu as an AI TikTok video generator to turn ideas and images into viral short-form videos with faster production workflows.\",\"title\":\"AI TikTok Video Generator for Short-Form Content\"},\"ai-video-generator\":{\"description\":\"Use Vidu, one of the best AI video generators, to create videos from text, images, and references with strong controls and flexible styles.\",\"title\":\"Best AI Video Generator for Text, Image \u0026 Reference Inputs\"},\"banned\":{\"description\":\"This page is restricted. If you see this page, your account has been blacklisted. For more information or to resolve the issue, please contact Vidu support.\",\"title\":\"Access Denied: Blacklist Notice\"},\"character2video\":{\"description\":\"Try Vidu's Reference to Video feature to generate AI videos with multi-reference consistency.\",\"title\":\"Reference to Video\"},\"characterCreation\":{\"description\":\"Enter prompts and style to generate References with AI\",\"title\":\"Character Generator\"},\"claw\":{\"description\":\"Vidu Claw, your first AI marketing agent built on OpenClaw\",\"title\":\"Vidu Claw | Sessions\"},\"clawCases\":{\"description\":\"Browse curated Vidu Claw cases to explore creative possibilities and find inspiration for your next project.\",\"title\":\"Vidu Claw | Cases\"},\"clawFile\":{\"description\":\"View and manage all the files you've created with Vidu Claw. Easily view, re-edit, and share your file content here.\",\"title\":\"Vidu Claw | Files\"},\"consentFace\":{\"description\":\"Vidu AI Authorization and Consent for Collection and Processing of Sensitive Personal Information (Facial Recognition Features).\",\"title\":\"Authorization Consent for Facial Feature Processing\"},\"consentVoice\":{\"description\":\"Vidu AI Authorization and Consent for Collection and Processing of Sensitive Personal Information (Voiceprint Features).\",\"title\":\"Authorization Consent for Voiceprint Feature Processing\"},\"cookies\":{\"description\":\"This page explains how Vidu uses cookies to enhance your experience and ensure the website functions properly.\",\"title\":\"Cookie Policy\"},\"cookiesPolicy\":{\"description\":\"This Cookies Policy describes the details of cookies and other similar tracking technologies used on Vidu.\",\"title\":\"Cookies Policy\"},\"cpp\":{\"description\":\"Join the Vidu Creative Partners Program to get creator perks, credits, promotion opportunities, and collaboration support.\",\"title\":\"Vidu Creative Partners Program (CPP)\"},\"creations\":{\"description\":\"View and manage all the AI videos you've created with Vidu. Easily view, re-edit, and share your video content here.\",\"title\":\"My Creations\"},\"creativeTools\":{\"description\":\"Experience the powerful capabilities of Vidu Video Generation Agent. Integrating flexible canvas editing and conversational interaction, it generates long videos with voiceover dubbing via one-sentence commands—an AI-powered efficient video creation platform.\",\"title\":\"Vidu Agent\"},\"elements\":{\"description\":\"Create and edit my references, efficiently use my references in the video creation process, and generate AI videos that maintain multi-reference consistency, including multiple character consistency, scene consistency, and object consistency\",\"title\":\"My References\"},\"explore\":{\"activity\":{\"description\":\"Explore and join the exciting activities and contests hosted by Vidu AI. Stay updated and never miss the best moments.\",\"title\":\"Activities\"},\"inspiration\":{\"description\":\"Explore the Inspiration hub on Vidu—discover outstanding AI videos created by other users. Get inspired, recreate with one click, or save your favorites.\",\"title\":\"Inspiration\"},\"reference\":{\"description\":\"Welcome to Vidu's RefHub—explore, use, and save references created by other users to inspire your own AI video creations.\",\"title\":\"RefHub\"},\"shortFilm\":{\"description\":\"Browse a curated collection of short films generated by Vidu. See how users bring their stories to life using AI.\",\"title\":\"Short Film\"},\"tutorial\":{\"description\":\"Learn how to use Vidu efficiently and create high-quality AI videos through step-by-step guides.\",\"title\":\"Tutorial\"}},\"extension\":{\"description\":\"Expand your clips seamlessly using our generative AI Video Extender. Automatically generate missing frames, extend duration, and outpaint boundaries with advanced AI technology.\",\"title\":\"AI Video Extender: Seamlessly Expand Video Length \u0026 Boundaries\"},\