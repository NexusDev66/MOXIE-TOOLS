m via QR code\"}},\"weixin\":{\"description\":{\"card\":\"Automatically configures the WeChat bot with no manual setup required\",\"nav\":\"Auto-configured, no manual setup required\"},\"modalTitle\":\"Bind WeChat Notifications\",\"title\":{\"card\":\"Connect WeChat notifications via QR code\",\"menu\":\"WeChat\",\"nav\":\"Connect WeChat via QR code\"}}},\"common\":{\"cancel\":\"Cancel\",\"loadConfigFailed\":\"Failed to load configuration\",\"loadingConfig\":\"Loading configuration...\",\"retry\":\"Retry\",\"save\":\"Save Configuration\",\"saveSuccess\":\"Notification configuration saved\"},\"errors\":{\"bindFailed\":\"Binding failed\",\"invalidJsonField\":\"{field} must be a valid JSON object\",\"invalidResponse\":\"Invalid response from server\",\"loadConfig\":\"Failed to load configuration\",\"network\":\"Network error\",\"pollBindStatus\":\"Failed to poll binding status\",\"qrExpired\":\"QR code expired\",\"requiredField\":\"Please enter {field}\",\"saveConfig\":\"Failed to save configuration\",\"startBindFlow\":\"Failed to start binding flow\"},\"fields\":{\"allowFrom\":{\"description\":\"Leave empty to allow all users.\",\"label\":\"Allowed User IDs\",\"placeholder\":\"Enter user IDs separated by commas or new lines\"},\"appId\":{\"label\":\"App ID\",\"placeholder\":\"Enter the App ID starting with cli_\"},\"appSecret\":{\"label\":\"App Secret\",\"placeholder\":\"Enter the App Secret\"},\"clientId\":{\"label\":\"Client ID\",\"placeholder\":\"Enter the DingTalk app Client ID\"},\"clientSecret\":{\"label\":\"Client Secret\",\"placeholder\":\"Enter the DingTalk app Client Secret\"},\"discordToken\":{\"label\":\"Bot Token\",\"placeholder\":\"Enter the Discord bot token\"},\"enabled\":{\"description\":\"Enable {channel} notifications to scan the QR code to complete the binding. Disable to turn it off.\",\"label\":\"Enable {channel} notifications\"},\"encryptKey\":{\"label\":\"Encrypt Key\",\"placeholder\":\"Enter the event callback encryption key\"},\"feishuAppId\":{\"description\":\"Feishu app App ID, starting with cli_.\"},\"feishuIsLark\":{\"description\":\"Whether to use the Lark international domain (open.larksuite.com). Defaults to false, which uses the Feishu domain (open.feishu.cn).\"},\"groupTrigger\":{\"description\":\"Optional group trigger settings as a JSON object, for example '{'\\\"mention_only\\\": false'}'.\",\"label\":\"Group Trigger Settings\",\"placeholder\":\"Enter a JSON object, for example\\n'{'\\n  \\\"mention_only\\\": false\\n'}'\"},\"isLark\":{\"label\":\"Use Lark international domain\"},\"larkAppId\":{\"description\":\"Lark/Feishu app App ID, starting with cli_.\"},\"larkIsLark\":{\"description\":\"Whether to use the Lark international domain (open.larksuite.com). Defaults to false, which uses the Feishu domain (open.feishu.cn).\"},\"proxy\":{\"label\":\"Proxy URL\",\"placeholder\":\"Enter the Telegram API proxy URL, for example http://127.0.0.1:7890\"},\"randomReactionEmoji\":{\"description\":\"Leave empty to use the default Pin.\",\"label\":\"Random Reaction Emojis\",\"placeholder\":\"Enter emojis separated by commas or new lines\"},\"telegramMarkdownV2\":{\"description\":\"When enabled, messages will be rendered using Telegram MarkdownV2 formatting.\",\"label\":\"Enable MarkdownV2 formatting\"},\"telegramToken\":{\"label\":\"Bot Token\",\"placeholder\":\"Enter the Telegram bot API token\"},\"verificationToken\":{\"label\":\"Verification Token\",\"placeholder\":\"Enter the token used for webhook verification\"}},\"guideTitle\":\"View how to configure {channel} notifications\",\"navTrigger\":{\"description\":\"Auto-configured, no manual setup\",\"title\":\"Connect Notifications\"}},\"chat\":{\"activeTaskBanner\":\"Task is running...\",\"anchor\":{\"assistantOutput\":\"Output ready\"},\"collapse\":\"Collapse\",\"emptySession\":{\"description\":\"The first message was not sent, or this session has no history yet.\",\"title\":\"No messages in this session\"},\"error\":{\"failed\":\"The system is busy. Please try again later.\"},\"inputPlaceholder\":\"Type a message...\",\"quickPrompt\":{\"shuffle\":\"Shuffle\"},\"sessionForbidden\":\"You do not have permission to access this conversation\",\"sessionNotFound\":\"This conversation does not exist\",\"share\":{\"deselectAll\":\"Deselect all\",\"error\":\"Failed to get share link, please try again later.\",\"errorFileTooLarge\":\"Total file size exceeds 500MB, sharing is not allowed.\",\"errorMessageTooMany\":\"Message count exceeds 2000, sharing is not allowed.\",\"failed\":\"Failed to copy share link. Please try again later.\",\"selectAll\":\"Select all\",\"selectedCount\":\"{count} messages selected\",\"success\":\"Share link copied successfully\"},\"shareSession\":{\"description\":\"7×24 AI Creative Employee\",\"end\":\"Ended\",\"nickname\":\"Author\",\"replay\":\"Replay\",\"reply\":\"Reply\",\"toResult\":\"Go to result\",\"tryNow\":\"Try Now\"},\"submitError\":{\"ClawDurationOutOfRange\":\"Storyboard duration must be between 4 and 15 seconds.\",\"ClawSegmentsRequired\":\"Please add at least one storyboard before submitting.\",\"ClawSessionMaterialNotFound\":\"Some referenced assets are not in the current session folder. Upload them to {folder} and try again.\",\"ClawSessionNotYolo\":\"This session is not in YOLO mode and cannot submit storyboards.\",\"ClawStoryboardAudioRequiresImage\":\"A storyboard with audio requires at least one image.\",\"ClawStoryboardInvalidAudioPath\":\"The audio field must reference an audio file.\",\"ClawStoryboardInvalidImagePath\":\"The image fields must reference image files.\",\"ClawStoryboardInvalidVideoPath\":\"The video field must reference a video file.\",\"ClawStoryboardMaterialPathInvalid\":\"Material path is invalid. Please reselect the asset.\",\"ClawStoryboardMaterialPathRequired\":\"Material path is required.\",\"ClawStoryboardPromptRequired\":\"The storyboard prompt is required.\",\"ClawStoryboardTooManyAudios\":\"Each storyboard can contain at most 1 audio.\",\"ClawStoryboardTooManyImages\":\"Each storyboard can contain at most 7 images.\",\"ClawStoryboardTooManyVideos\":\"Each storyboard can contain at most 1 video.\",\"ClawStoryboardUnsupportedMaterial\":\"Unsupported material file type.\",\"CreditInsufficient\":\"Not enough credits. Please top up and try again.\",\"default\":\"Submission failed. Please try again later.\",\"Forbidden\":\"You don't have permission to perform this action.\",\"InternalError\":\"Service is temporarily unavailable. Please try again later.\",\"PermissionDenied\":\"You don't have permission to perform this action.\",\"QuotaExceeded\":\"Task limit reached. Please wait for current tasks to finish before retrying.\",\"SessionNotFound\":\"Session no longer exists. Please refresh and try again.\",\"TooManyRequests\":\"Too many requests. Please try again in a moment.\",\"Unauthorized\":\"Your session has expired. Please sign in again.\"},\"subtask\":{\"collapse\":\"Collapse subtasks\",\"expand\":\"Expand subtasks\",\"summary\":\"\u003cnum\u003e{total}\u003c/num\u003e guys on the team: \u003cnum\u003e{completed}\u003c/num\u003e are all set, \u003cnum\u003e{running}\u003c/num\u003e are still at it.\",\"summaryDone\":\"\u003cnum\u003e{total}\u003c/num\u003e guys on the team: all done!\"},\"taskPanel\":{\"collapse\":\"Collapse tasks\",\"expand\":\"Expand tasks\",\"round\":\"{index} round\"},\"thinking\":{\"loading\":\"Thinking...\",\"thinkingProcess\":\"Thinking process\"},\"tip\":\"Vidu Claw can make mistakes, consider checking important information.\",\"tool\":{\"usedTools\":\"Used {count} tools\"},\"welcome\":{\"applyClawCodeDialog\":{\"activatedDescription\":\"Your ViduClaw is ready. Start chatting now.\",\"activatedTitle\":\"ViduClaw activated\",\"confirm\":\"Confirm\",\"creatingDescription\":\"We are setting up your ViduClaw, this will take a few minutes.\",\"creatingTitle\":\"Activating ViduClaw\",\"gotIt\":\"Got it\",\"inputTitle\":\"Enter your invitation code\",\"notice\":\"You can keep using Vidu whil