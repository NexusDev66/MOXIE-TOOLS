reative\",\"tooltip\":\"Richer transitions and camera movements\"},\"optionStable\":{\"text\":\"Stable\",\"tooltip\":\"Smooth transitions and static shots\"},\"title\":\"Style Preference\"},\"templateName\":{\"title\":\"Template Name\"},\"title\":\"Settings\"},\"submit\":\"Create\",\"upload\":{\"addImage\":\"Add Image\",\"cancel\":\"Cancel\",\"characterOption\":\"Use for Character Reference\",\"clothPlaceholder\":\"Upload a \u003cspan\u003eClothing\u003c/span\u003e photo\",\"confirm\":\"Confirm\",\"crop\":\"Crop\",\"cropImage\":\"Crop Images\",\"error\":{\"AuditSubmitIllegal\":\"The uploaded content may violate our Content Policy. Please try another one.\",\"incorrectExtension\":\"The image extension does not match the actual image format. Please re-upload.\",\"invalidArea\":\"Minimum upload size is 128×128. Please re-upload a compliant image.\",\"invalidImage\":\"The browser does not support the image. Please try another image.\",\"invalidRatio\":\"Max aspect ratio 4:1. Please re-upload a compliant image.\",\"invalidResolution4k\":\"Please upload or select an image with a resolution below 4K.\",\"invalidSize\":\"Max image size ({limit}). Please re-upload a compliant image.\",\"invalidType\":\"We only support JPG, PNG and WebP image formats currently.\"},\"firstFrame\":{\"display\":\"First Frame Display\",\"placeholder\":\"First\",\"tab\":\"First Frame\"},\"frameOption\":\"Use as First Frame\",\"imageCount\":\"{current}/{max} images\",\"imageCountLimit\":\"Upload 1-4 images\",\"lastFrame\":{\"display\":\"Last Frame Display\",\"placeholder\":\"Last (Optional)\",\"tab\":\"Last Frame\"},\"modelPlaceholder\":\"Upload a \u003cspan\u003eModel\u003c/span\u003e photo\",\"nthFrame\":\"Frame {num}\",\"placeholder\":\"Drag an image here or select an image to upload\",\"removeFirstFrameWithTransitionTip\":\"Deleting the first frame also removes the following transition\",\"removeImage\":\"Delete Image\",\"removeImageWithTransitionTip\":\"Deleting the image also removes the prev