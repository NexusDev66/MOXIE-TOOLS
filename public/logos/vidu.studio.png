:{\"description\":\"Explore Vidu's tailored pricing plans and compare features to find the ideal AI video generation solution for your personal or professional projects.\",\"title\":\"Pricing\"},\"personalInfoCollection\":{\"description\":\"Vidu AI Personal Information Collection List - details the personal information fields we collect across various business scenarios.\",\"title\":\"Personal Information Collection List\"},\"personalInfoSharing\":{\"description\":\"Vidu AI Third-Party Information Sharing List and SDK Directory - details how we share personal information with third parties.\",\"title\":\"Third-Party Information Sharing List\"},\"pricing\":{\"description\":\"Compare Vidu pricing plans, credits, and features to choose the right option for AI video generation, image-to-video, and creator workflows.\",\"title\":\"Vidu Pricing Plans for AI Video Generation\"},\"privacy\":{\"description\":\"We prioritize our users' privacy and want to inform you about how we handle and protect your personal information.\",\"title\":\"Privacy Policy\"},\"privacyPolicy\":{\"description\":\"Vidu AI Privacy Policy - learn how Beijing Shengshu Technology Co., Ltd. collects, uses, and protects your personal information.\",\"title\":\"Privacy Policy\"},\"privacySummary\":{\"description\":\"Vidu AI Privacy Policy Summary - a concise overview of how we collect, use, and share your personal information.\",\"title\":\"Privacy Policy Summary\"},\"profile\":{\"description\":\"Your personal profile will display the contents you have published or liked\",\"title\":\"Profile\"},\"reference2image\":{\"description\":\"Upload images to merge elements into a new image, or edit one with text prompts, then export high-resolution photos.\",\"title\":\"Reference to Image\"},\"serviceTerms\":{\"description\":\"Vidu AI Service Terms for users in mainland China - outlines the conditions for accessing and using the Vidu AI service.\",\"title\":\"Service Terms (China)\"},\"share\":{\"description\":\"