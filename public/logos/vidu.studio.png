roject\":{\"allProjects\":\"All Projects\",\"seeAll\":\"See All\",\"title\":\"Projects\"},\"noMore\":\"No more\",\"noRecord\":\"No content\",\"operationSelect\":{\"add_to_chat\":\"Add to chat\",\"copy\":\"Copy\",\"download\":\"Download\",\"edit_in_clip\":\"Edit Storyboard\",\"error\":\"Operation failed\",\"generate_same\":\"Regenerate\",\"generate_video\":\"Create video\",\"QuotaExceededError\":\"Task limit reached. Try again after completing current tasks\",\"try_again\":\"Try Again\"},\"partner\":\"Your professional video creation partner\",\"project\":{\"newProject\":\"New Project\",\"renameSuccess\":\"Rename Successfully\"},\"scene\":{\"common\":{\"dialogTitle\":\"General Creation\",\"tip\":\"Adaptable to all regular scenarios for more flexible creation\",\"title\":\"General Creation\"},\"e_commerce\":{\"dialogTitle\":\"E-commerce\u0026Ads Video Creation\",\"tip\":\"Optimized for e-commerce advertising scenarios, enabling efficient marketing content generation\",\"title\":\"E-commerce \u0026 Ads\"},\"remake\":{\"dialogTitle\":\"Video Clone Creation\",\"tip\":\"Upload a reference video to quickly generate new videos with similar structure and style\",\"title\":\"Video Clone\"}},\"sceneSelect\":{\"tip\":\"Select Creative Scenario\",\"title\":\"Scenario\"},\"scriptNode\":{\"aside\":\"Voiceover\",\"duration\":\"Duration\",\"lens\":\"Lens\",\"prompts\":\"Prompts\",\"shot\":\"Shot{number}\",\"stage\":{\"1\":\"First Stage\",\"2\":\"Second Stage\",\"3\":\"Third Stage\",\"4\":\"Fourth Stage\",\"5\":\"Fifth Stage\",\"6\":\"Sixth Stage\",\"7\":\"Seventh Stage\",\"8\":\"Eighth Stage\",\"9\":\"Ninth Stage\",\"10\":\"Tenth Stage\",\"11\":\"Eleventh Stage\",\"12\":\"Twelfth Stage\",\"13\":\"Thirteenth Stage\",\"14\":\"Fourteenth Stage\",\"15\":\"Fifteenth Stage\"},\"storyboard\":\"Storyboard\",\"title\":\"Creation Script\"},\"simpleProjectTips\":{\"button\":\"Upgrade\",\"create\":\"Create\",\"disabledTip\":\"Read-only mode active. Creating a new project is required to edit.\",\"invitedButton\":\"Invite Now\",\"invitedTip\":\"Invite friends and get free projects.\",\"title\":\"Read-only mode. Edit after upgrade\"},\"skill\":{\"generateScript\":\"MarketScript Pro\",\"title\":\"You Can Try Script Skill\"},\"subtitle\":\"From a click to a 15-30s multi-shot video with voiceover\",\"switchSuccess\":\"Succeed\",\"try\":\"Try\",\"userInfo\":{\"creditsDetails\":\"Credits Details\"},\"videoNode\":{\"failedToast\":\"Oops, generation failed! You can edit the failed clips in the storyboard and regenerate for free.\",\"history\":\"History\"},\"voiceLanguage\":{\"all\":\"All\",\"ar\":\"Arabic\",\"cs\":\"Czech\",\"de\":\"German\",\"el\":\"Greek\",\"en\":\"English\",\"es\":\"Spanish\",\"fi\":\"Finnish\",\"fr\":\"French\",\"hi\":\"Hindi\",\"id\":\"Indonesian\",\"it\":\"Italian\",\"ja\":\"Japanese\",\"ko\":\"Korean\",\"nl\":\"Dutch\",\"pl\":\"Polish\",\"pt\":\"Portuguese\",\"ro\":\"Romanian\",\"ru\":\"Russian\",\"th\":\"Thai\",\"tr\":\"Turkish\",\"uk\":\"Ukrainian\",\"vi\":\"Vietnamese\",\"zh\":\"Chinese\"},\"voiceSelect\":{\"auto\":\"AI Voiceover\",\"autoTooltip\":\"Automatically pairs a fitting voice tone based on your prompt\",\"selected\":\"Selected\",\"shareTitle\":\"Voiceover\",\"tip\":\"Select voiceover tone\",\"tipTooltip\":\"Pick a fitting tone for your voice over\",\"title\":\"Voice Over Tone Selection\"},\"warning\":{\"nameConflict\":\"Name exists. Please re-enter.\",\"nameRequiredFile\":\"Project name cannot be empty\"},\"welcome\":{\"enterThoughts\":\"Enter your thoughts\",\"hi\":\"Hi, {name}\",\"title\":\"How to use\",\"viewAll\":\"See All\",\"welcomeTip\":\"What will we create today? \"},\"welcomeGuide\":{\"step1\":\"Pick scenario → upload product images/prompt to start creation\",\"step2\":\"AI auto-designs storyboards/voiceovers (editable anytime)\",\"step3\":\"Canvas → flexible content adjustments/edits\"}},\"ai-image-generator\":{\"buttons\":{\"generateNow\":\"Generate Now\"},\"faq\":{\"q1\":{\"description\":\"Vidu leads in consistency, speed, and production-quality output, ranking above major global models in editing and identity preservation benchmarks.\",\"title\":\"What makes Vidu AI different from other AI image generators?\"},\"q2\":{\"description\":\"Yes. Vidu supports up to seven reference images or subjects in a single generation. The model maintains high spatial and identity coherence even with complex multi-reference setups, delivering stable characters, consistent styling, and accurate layouts throughout the output.\",\"title\":\"Does Vidu support multiple reference images?\"},\"q3\":{\"description\":\"Yes. Vidu allows you to edit images generated on the platform by adjusting image size, output resolution, and generation model. In addition, you can freely add, modify, or remove elements within an image, such as objects, backgrounds, outfits, and details. This enables creators to efficiently iterate on visuals and adapt them to different formats and production needs without starting from scratch.\",\"title\":\"Can I edit generated images?\"},\"q4\":{\"description\":\"Photorealistic, anime, comic, cinematic, product renderings, and Chinese ink-painting with distinctive texture rendering.\",\"title\":\"What styles does Vidu support?\"},\"q5\":{\"description\":\"Yes. With support for 2K/4K images and fast rendering, it is designed for real production environments, including marketing, advertising, design, and film pre-visualization.\",\"title\":\"Is Vidu suitable for commercial use?\"},\"title\":\"FAQs About Vidu AI Image Generator\"},\"imageEditing\":{\"description\":\"Edit after you generate. Finish the job with built-in AI editing designed for real-world delivery.\",\"features\":{\"editContent\":{\"description\":\"Add, remove, or modify any element in the image with targeted edits. Refine details without needing to regenerate the entire image.\",\"title\":\"Edit content\"},\"resize\":{\"description\":\"Adapt images for different platforms, layouts, and aspect ratios with minimal effort. Reformat assets while retaining visual clarity and structure.\",\"title\":\"Resize\"},\"upscale\":{\"description\":\"Increase clarity and sharpness for publishing, sharing, or delivery in higher-quality formats. Maintain clean lines and details as resolution increases.\",\"title\":\"Upscale resolution\"}},\"title\":\"AI Image Editing\"},\"referenceToImage\":{\"description\":\"Upload a reference image or multiple images, and tell the model what to keep, what to change, and what to combine.\",\"features\":{\"anyStyle\":{\"description\":\"Generate aesthetically polished images across a wide range of styles and scenarios—anime, photorealistic, advertising, artistic visuals, etc.\",\"title\":\"Any style, any use case\"},\"mergeElements\":{\"description\":\"Combine features across multiple references into a single cohesive image. Preserve the key attributes you care about while keeping the overall look unified.\",\"title\":\"Merge elements\"},\"superConsistency\":{\"description\":\"Keep characters, objects, and visual style stable across multiple generations. Useful for series creation, brand consistency, and long-running visual projects.\",\"title\":\"Super consistency\"}},\"title\":\"Reference to Image\"},\"step\":{\"step1\":{\"description\":\"Select Text-to-Image or Reference-to-Image.\",\"title\":\"Choose your mode\"},\"step2\":{\"description\":\"For Text to Image: describe your scene or style. For Reference to Image: upload one or multiple reference photos and add a prompt.\",\"title\":\"Add your prompt or upload images\"},\"step3\":{\"description\":\"Choose resolution, size, and quantity, then click Create. Afterward, edit your result: resize, refine content, or upscale.\",\"title\":\"Set options and generate\"},\"title\":\"How to Generate Images with Vidu AI Image Generator\"},\"subtitle\":\"Turn text prompts or reference photos into ultra-HD images with consistent results—transform styles, merge elements, then edit after generation: resize, refine, and upscale.\",\"textToImage\":{\"description\":\"Describe what you want—subject, style, lighting, mood, camera angle—and generate high-quality images in seconds.\",\"features\":{\"anySize\":{\"description\":\"Create any aspect ratio for ads, product shots, posters, social posts, and custom layouts. Composition stays balanced across different canvas sizes.\",\"title\":\"Any size\"},\"fastGeneration\":{\"description\":\"Get strong results in a few seconds to support rapid iteration and higher creative throughput. Ideal for testing prompts, styles, and variations without long waits.\",\"title\":\"Fast generation\"},\"ultraHd\":{\"description\":\"Generate in 1080p, 2K, or 4K with crisp details, accurate textures, and clean edges. Suitable for marketing assets, product visuals, and high-resolution publishing.\",\"title\":\"Ultra-HD output\"}},\"title\":\"Text to Image\"},\"title\":\"AI Image Generator \u0026 Editor\",\"whyChoose\":{\"advantages\":{\"consistency\":{\"description\":\"Reliable style and subject stability across outputs.\",\"title\":\"Super consistency\"},\"editing\":{\"description\":\"Resize, refine, and upscale without leaving the workflow.\",\"title\":\"Post-editing abilities\"},\"imageToVideo\":{\"description\":\"One-click image-to-video workflow.\",\"title\":\"Unified Image-to-Video\"},\"ultraHd\":{\"description\":\"Built for sharp, professional output.\",\"title\":\"Ultra-HD (1080p/2K/4K)\"}},\"title\":\"Why Choose Vidu AI Image Generator\"}},\"ai-image-to-video\":{\"advantage\":{\"cinematicQuality\":{\"description\":\"See your images in sharp detail with bright, vivid colors. Each frame feels like a real movie scene, clear and immersive.\",\"title\":\"Cinematic HD Quality\"},\"diverseStyles\":{\"description\":\"Pick from different animation styles and make your images move naturally. Convert images to video online free with Vidu. All motion flows smoothly, whether small or dramatic.\",\"title\":\"Dynamic Motion, Any Animation Style\"},\"expressiveMotion\":{\"description\":\"Movements flow smoothly, from subtle gestures to bold shifts. Every action connects naturally, keeping the scene lively and easy to follow.\",\"title\":\"Expressive, High-Dynamic Motion\"}},\"buttons\":{\"generateNow\":\"Generate Now\"},\"cta\":{\"button\":\"Generate Now\",\"ctaTitle\":\"Turn Your Images into Videos Now\",\"title\":\"Vidu AI Image to Video\"},\"faq\":{\"q1\":{\"description\":\"AI image to video turns a single image into a dynamic video using motion generation. Upload your image, add a prompt, and the AI creates smooth, cinematic motion automatically. It keeps details consistent while transforming static visuals into engaging video content.\",\"title\":\"What is AI Image to Video and how does it work?\"},\"q2\":{\"description\":\"Yes, image to video tools like Vidu let you define how your image moves. You can guide subject motion, camera movement, and even set first and last frames. This gives you more control when you convert image to video with natural, stable results.\",\"title\":\"Can I control motion in image to video generation?\"},\"q3\":{\"description\":\"You can use photos, illustrations, anime, sketches, or digital art. Image to video AI keeps the original style while adding smooth and realistic motion.\",\"title\":\"What types of images can I use for image to video AI?\"},\"q4\":{\"description\":\"Use high-quality images with clear subjects and good lighting for best results. Keep prompts simple and focused to avoid unnatural or jumpy motion.\",\"title\":\"How can I improve results when using an image to video generator?\"},\"q5\":{\"description\":\"Focus on describing motion, not repeating the image—define how the subject moves. Add camera movement (pan, zoom, tracking) for more cinematic results. Use a simple formula for image to video: subject motion + camera movement + scene change + style.\",\"title\":\"How to Write Motion Prompts for Image to Video\"},\"q6\":{\"description\":\"Use image to video when you want to animate a single image or create quick motion from visuals. Use reference to video when you need consistent characters, scenes, and storytelling across multiple shots. In practice, combine both—image to video for simple clips, and reference to video for complex, story-driven videos.\",\"title\":\"When should I use Reference to Video vs Image to Video?\"},\"title\":\"FAQs about Image to Video Feature\"},\"feature\":{\"firstAndLast\":{\"description\":\"Define the first and last frames and let image to video turn your image into a smooth video. The motion between frames flows naturally and all elements stay in place. It works with any type of image, from photos to drawings and digital art.\",\"title\":\"First \u0026 Last Frames Control\"}},\"mistakes\":{\"lowQualitySource\":{\"description\":\"Blurry or low-resolution images make the video look unclear. Details can get lost, and motion may look rough. Use sharp images with clear lighting so the result looks clean and stable.\",\"title\":\"Low-quality source images\"},\"overloadedPrompt\":{\"description\":\"Too many instructions in one prompt can confuse the motion. The result may look unnatural or jumpy. Keep your prompt simple and focus on one main action or idea.\",\"title\":\"Overloaded motion prompts\"},\"smallSubject\":{\"description\":\"If the subject is too small or hard to see, the motion can look messy. The AI may not know what to focus on. Keep the main subject large and clear in the frame so movements stay accurate.\",\"title\":\"Subjects that are too small or unclear\"},\"title\":\"Common Image to Video Mistakes and How to Improve Results\"},\"nextLevel\":{\"title\":\"Next-Level Image to Video\"},\"step\":{\"step1\":{\"description\":\"Click 'Try Vidu' to open the dashboard. Select 'Image to Video' and upload your first image as the starting frame. You can also add a second image as the ending frame if you want.\",\"title\":\"Choose Image to Video\"},\"step2\":{\"description\":\"Type a prompt that describes how you want the video to look. Check the User Guide to see tips on using the photo-to-video tool.\",\"title\":\"Write a Prompt for Image to Video Maker\"},\"step3\":{\"description\":\"Set the duration, resolution, and movement amount for your video. If you want more than one video, use the slider in Amount. Then click Create to make your video.\",\"title\":\"Adjust Settings for Final Video Output\"},\"title\":\"How to Convert an Image to Video\"},\"styles\":{\"anime\":{\"title\":\"Anime\"},\"description\":\"Turn any image into a video in the style you want. Use photos, anime, sketches, or paintings. Vidu keeps the look the same and makes the motion smooth.\",\"illustration\":{\"title\":\"Illustration\"},\"realistic\":{\"title\":\"Realistic Video\"},\"surreal\":{\"title\":\"Surreal\"},\"title\":\"Image to Video in Various Styles\"},\"subtitle\":\"Turn images into smooth videos with AI image to video. Upload your image, define how it should move, and Vidu generates cinematic videos with natural motion, consistent details, and professional quality in seconds.\",\"title\":\"AI Image to Video\",\"useCase\":{\"memories\":{\"description\":\"Animate vintage or family photos with gentle, lifelike motion. Vidu adds emotion to old moments, making them perfect for storytelling or personal gifts.\",\"title\":\"Revive Old Memories\"},\"productVideos\":{\"description\":\"Bring product photos to life with smooth motion and simple cinematic transitions. Turn a single product image into a video that grabs attention and works well for online stores or ads.\",\"title\":\"Create Product Videos\"},\"professionalShorts\":{\"description\":\"Turn your concept art, mood boards, or character designs into short cinematic videos. Vidu keeps visuals consistent and stylish while telling a clear story. Perfect for filmmakers, animators, and creative teams.\",\"title\":\"Create Professional Shorts\"},\"socialMedia\":{\"description\":\"Turn selfies, portraits, or digital art into videos that catch the eye. Convert images to video AI free no sign up with Vidu. Make Reels, TikToks, or Stories that feel alive and stand out from static posts.\",\"title\":\"Stand Out on Social Media\"},\"title\":\"Turn Images into Videos for Any Purpose\"}},\"ai-reference-to-video\":{\"advantage\":{\"flexibleReferenceCreation\":{\"description\":\"You can create your own or or select from our RefHub. Each reference can capture character, style, composition, camera movement, scene, and effects etc. from source images or videos.\",\"title\":\"Flexible Reference Creation\"},\"moreCharacters\":{\"description\":\"Support up to 7 references at once to create more complex, story-driven videos with multiple characters, richer scenes, and strong visual continuity. Vidu intelligently blends them to keep everything consistent across shots.\",\"title\":\"Multi-reference support\"},\"sameScene\":{\"description\":\"Maintain a coherent visual style from backgrounds to props. Every scene looks polished and professional, keeping your storytelling smooth.\",\"title\":\"Scene continuity and style preservation\"},\"sameSubject\":{\"description\":\"Ensure characters look the same, move naturally, and maintain their design in every frame. Vidu’s AI reference to video technology guarantees consistent characters even in complex sequences.\",\"title\":\"Character consistency across scenes\"}},\"buttons\":{\"generateNow\":\"Generate Now\"},\"comparison\":{\"columns\":{\"dimension\":\"Dimension\",\"imageToVideo\":\"Image to Video\",\"referenceToVideo\":\"Reference to Video\"},\"description\":\"If you focus on storytelling and consistency, use Reference to Video; if you want to animate a single image or keyframes, use Image to Video.\",\"rows\":{\"bestFor\":{\"dimension\":\"Best For\",\"imageToVideo\":\"Quick content, product animation, social media clips\",\"referenceToVideo\":\"Storytelling, ads, AI influencers, multi-scene workflows\"},\"complexity\":{\"dimension\":\"Complexity\",\"imageToVideo\":\"Low\",\"referenceToVideo\":\"Medium to high\"},\"consistency\":{\"dimension\":\"Consistency\",\"imageToVideo\":\"Limited — not designed for multi-scene consistency\",\"referenceToVideo\":\"Strong — maintains character identity \u0026 scene continuity\"},\"controlLevel\":{\"dimension\":\"Control Level\",\"imageToVideo\":\"Moderate — mainly motion \u0026 visual animation\",\"referenceToVideo\":\"High — control character, style, composition, camera, effects\"},\"coreUseCase\":{\"dimension\":\"Core Use Case\",\"imageToVideo\":\"Animate a single image or start–end frames\",\"referenceToVideo\":\"Consistency-driven video generation across multiple shots\"},\"inputType\":{\"dimension\":\"Input Type\",\"imageToVideo\":\"Single image or keyframes\",\"referenceToVideo\":\"Reference video / multiple references (image, video, prompt)\"},\"output\":{\"dimension\":\"Output\",\"imageToVideo\":\"Short, loopable or simple motion video\",\"referenceToVideo\":\"Multi-shot, narrative, structured video\"}},\"title\":\"Reference to Video or Image to Video? How to Choose for Your Project\"},\"createWithoutLimits\":{\"description\":{\"caption1\":\"@Cowboy\",\"caption2\":\"@Bar\",\"caption3\":\"@Lady\",\"line1\":\"sits at the bar in\",\"line2word1\":\"A\",\"line2word2\":\"enters from the right with a bottle of wine\",\"line3\":\" and walks up to him. The camera pushes in...\",\"total\":\"@Cowboy sits at the bar in @Bar. A @Lady enters from the right with a bottle of wine and walks up to him. The camera pushes in.\"},\"title\":\"Create Without Limits — Reference to Video\"},\"cta\":\"Try Reference to Video\",\"faq\":{\"q1\":{\"description\":\"Reference to Video is an AI video generation method that uses reference videos or images to create consistent, multi-shot videos. It allows you to control character identity, style, camera movement, and scene continuity for storytelling and professional content creation.\",\"title\":\"What is Reference to Video in AI video generation?\"},\"q2\":{\"description\":\"The main difference is that Reference to Video ensures character consistency across multiple scenes using reference images or videos, while Image to Video is designed to animate a single image with simple motion and less control over continuity.\",\"title\":\"What is the difference between Reference to Video and Image to Video?\"},\"q3\":{\"description\":\"To achieve strong character consistency in an AI video generator, you should use Reference to Video with well-defined reference images or videos. This helps keep characters, scenes, and visual style consistent across multiple shots.\",\"title\":\"How can I maintain character consistency in AI video generation?\"},\"q4\":{\"description\":\"You should use Reference to Video with reference images when creating story-driven videos, ads, or AI influencer content that requires consistent characters, stable scenes, and multi-shot continuity.\",\"title\":\"When should I use Reference to Video with reference images?\"},\"q5\":{\"description\":\"You can turn elements like character, style, composition, camera movement, scene, and effects into references from images or videos, and use them to guide and control Reference to Video generation for better character consistency.\",\"title\":\"What elements can be used as references in Reference to Video?\"},\"title\":\"FAQs About Vidu Reference to Video\"},\"keepConsistent\":{\"issues\":{\"continuity\":{\"description\":\"Add a few reference images and highlight key actions. Clear guidance lets Vidu know how characters and objects should look and move, keeping every scene consistent.\",\"title\":\"How to improve continuity\"},\"facesOutfits\":{\"description\":\"When a character appears in multiple shots, their face or clothes can look different without clear references. Vidu makes a reference subject for each character to keep them consistent.\",\"title\":\"Why faces or outfits change between shots\"},\"objects\":{\"description\":\"Objects can move, vanish, or look wrong if there's no clear guide. Reference videos show where each object belongs. Vidu keeps all items in place and looking the same across shots.\",\"title\":\"Why objects disappear or look different\"}},\"title\":\"Keep Your Video Consistent: Common Problems and Fixes\"},\"step\":{\"step1\":{\"description\":\"Go to the Vidu website and click Try Vidu. Choose Reference to Video. Upload 1–7 reference images. You can use your own images or pick from our RefHu library.\",\"title\":\"Select Reference to Video\"},\"step2\":{\"description\":\"Type what you want your character or object to do. You can also set the video resolution, aspect ratio, and other options to customize it.\",\"title\":\"Enter Your Prompt\"},\"step3\":{\"description\":\"Click Create and wait for Vidu to make your video. Once it’s ready, preview it and download it to your device.\",\"title\":\"Create and Download\"},\"title\":\"How to Use Vidu's Reference to Video\"},\"subtitle\":\"Create consistent AI videos using reference to video. Upload your references, and keep characters, objects, and scenes consistent across every shot for smooth, multi-scene videos.\",\"title\":\"AI Reference to Video\",\"useCase\":{\"advertising\":{\"description\":\"Keep every object and product perfectly consistent across frames with reference images. Details like shapes, colors, and textures stay true, so nothing fades, shifts, or changes unexpectedly.\",\"title\":\"Preserve product and object details\"},\"fun\":{\"description\":\"Reference to video can preserve the overall visual style, lighting, and scene composition. Your video story flows naturally, avoiding jarring changes between shots.\",\"title\":\"Maintain visual continuity in scenes and stories\"},\"narrativeShorts\":{\"description\":\"AI reference to video makes sure your characters look the same in all scenes. This is key for multi-shot videos or animations where characters appear repeatedly.\",\"title\":\"Keep the same character across multiple shots\"},\"personalIP\":{\"description\":\"Keep characters, logos, and brand elements consistent to protect your intellectual property and strengthen brand recognition.\",\"title\":\"Build more reliable brand and IP content\"},\"title\":\"Use Reference to Video for Consistent AI Video Creation\"}},\"ai-sound-effect-generator\":{\"buttons\":{\"generateNow\":\"Generate Now\"},\"cta\":{\"button\":\"Generate Now\",\"title\":\"Vidu AI Sound Effect Generator\"},\"faq\":{\"q1\":{\"description\":\"Vidu AI Sound Effect Generator creates high-quality audio from text prompts, allowing you to precisely control the duration and timing of each sound. It supports multiple layers, seamlessly layering and mixing sounds based on your descriptions.\",\"title\":\"How does the Text to Sound Effects Generator work?\"},\"q2\":{\"description\":\"It's ideal for creating custom sound effects, ambient audio, and instrumental tracks for movies, games, videos, podcasts, and other creative projects.\",\"title\":\"What are some primary use cases for text-to-audio technology?\"},\"q3\":{\"description\":\"Yes, the AI-generated sound effects from Vidu are royalty-free, allowing you to use them freely without additional licensing fees.\",\"title\":\"Are AI audio effects generated by Vidu royalty-free?\"},\"q4\":{\"description\":\"Absolutely, you can use Vidu's generated sound effects in commercial projects such as advertisements, films, games, and more.\",\"title\":\"Can I use the generated sound effects in commercial projects?\"},\"q5\":{\"description\":\"To get the best results, use 1 to 3 key sound elements per timestamp and avoid exceeding 5. Use 1 to 5 overlapping timestamps for optimal layering, and keep each timestamp's description under 100 characters.\",\"title\":\"What are the best practices for creating effective prompts with the AI Sound Effect Generator?\"},\"title\":\"FAQs About AI Sound Effect Generator\"},\"showcase\":{\"Ambient\":{\"Knife\":\"Knife chopping on a cutting board\",\"title\":\"Ambient \u0026 Sound Effects\",\"train\":\"A train horn, train wheels rubbing against the tracks\",\"Violent\":\"Violent impact sound, glass shattering, beast growling\",\"Waves\":\"Waves on the shore, seagulls calling, sea breeze\"},\"backgroundMusic\":{\"jazz\":\"Upbeat retro Latin jazz with guitar, percussion, saxophone, and piano — great for dance parties or sunny street scenes.\",\"light\":\"A gentle, pure flute melody with a light, flowing rhythm, evoking a sense of nature and fantasy — perfect for a springtime forest scene.\",\"title\":\"Background Music\"},\"description\":\"Discover the power of AI-generated sound—ambient effects, background music, and perfectly timed audio layers—all created by Vidu.\",\"feature\":{\"card\":{\"card1\":{\"description\":\"Generate sound effects that start at any specific time point within a 10-second window. Vidu offers fine-grained timing control, enabling creators to sync audio with visuals with precision.\",\"title\":\"Precise Sound Timing Control\"},\"card2\":{\"description\":\"Combine multiple audio segments into one seamless output. Vidu supports stacking and overlapping sound layers, making it easy to build complex and immersive soundscapes.\",\"title\":\"Flexible Layering \u0026 Combination\"},\"card3\":{\"description\":\"While most tools are limited to 16 KHz or 32 KHz, Vidu delivers studio-quality 48 KHz audio, setting a new benchmark for fidelity to AI-generated sound effects.\",\"title\":\"48 KHz High-Fidelity Audio Quality\"},\"card4\":{\"description\":\"Vidu's generated audio offers enhanced depth, seamless flow, and better emotional ambiance, making it ideal for creating dynamic and realistic sound environments.\",\"title\":\"Detailed and Immersive Sound Quality\"}},\"description\":\"Vidu makes it easy to create high-quality, precisely timed, and emotionally rich sound effects—perfect for videos, games, and creative projects.\",\"title\":\"Why Creators Love Vidu's AI Sound Effects\"},\"prompt\":\"Prompt\",\"Timed Layers\":\"Timed Audio Layers\",\"title\":\"AI Sound Showcase\"},\"step\":{\"step1\":{\"description\":\"Open the 'AI Sound Effects' tool, enter your prompt (e.g. 'wind, footsteps'), and adjust timestamps to control when each sound plays.\",\"title\":\"Enter Prompt \u0026 Set Timing\"},\"step2\":{\"description\":\"Choose a total duration (1–10 seconds) and make sure it covers all your sounds. Add more timestamps and layer sounds as needed.\",\"title\":\"Set Duration \u0026 Add Layers\"},\"step3\":{\"description\":\"Click Create to generate your audio. Once ready, download or share your custom AI-generated sound effect.\",\"title\":\"Generate \u0026 Download\"},\"title\":\"How to Make Sound Effects with AI\"},\"subtitle\":\"Turn text into high-quality audio, including sound effects, ambient sounds, and instrumental tracks.\",\"title\":\"AI Sound Effect Generator\"},\"ai-templates\":{\"bottomBannerTitle\":\"Try Vidu AI Templates for Fun and Advanced Video Generation\",\"breadcrumbs\":{\"home\":\"Home\",\"templates\":\"Templates\"},\"buttons\":{\"generateNow\":\"Generate Now\"},\"subtitle\":\"Discover Vidu's ready-made template library, and select from our featured kissing, hugging, or other fun video templates.\",\"title\":\"Vidu AI Video Templates\"},\"ai-text-to-video\":{\"buttons\":{\"generateNow\":\"Generate Now\"},\"cta\":{\"button\":\"Generate Now\",\"title\":\"Turn Your idea into Cinematic Videos Now\"},\"faq\":{\"q1\":{\"description\":\"AI text to video is a technology that turns a text prompt into a complete video. You simply describe a scene, action, or camera movement, and the AI generates multi-shot videos with smooth motion, consistent scenes, and built-in audio like voice and music.\",\"title\":\"What is AI text to video and how does it work?\"},\"q2\":{\"description\":\"Text to Video is best when you only have an idea—just describe a scene and the AI generates a full video. Image to Video is ideal when you already have visuals and want to animate them with consistent results. Use Text to Video for quick ideation, and Image to Video for controlled, consistent output.\",\"title\":\"What's the difference between Text to Video and Image to Video?\"},\"q3\":{\"description\":\"Weak AI videos often come from vague prompts, trying to include too many actions in one scene, or missing clear camera instructions. Be specific about the subject and setting, keep each scene focused on one main action, and include simple camera directions like pan, zoom, or close-up to improve results.\",\"title\":\"What common prompt mistakes lead to weak AI videos?\"},\"q4\":{\"description\":\"A text to video generator can create cinematic scenes, character animations, product videos, and storytelling content. From simple ideas to detailed prompts, AI text to video can generate visuals, motion, and sound together in one seamless workflow.\",\"title\":\"What can a text to video generator create?\"},\"q5\":{\"description\":\"To get better results, structure your text prompt with key elements like subject, action, camera, scene, and style. Clear and specific prompts help the AI text to video system generate more accurate visuals, smoother motion, and stronger storytelling.\",\"title\":\"How do I write a better text prompt for AI text to video?\"},\"q6\":{\"description\":\"An AI text to video generator lets you create videos instantly without filming or editing. It speeds up idea testing, reduces production time, and allows you to turn any text prompt into high-quality video content with minimal effort.\",\"title\":\"Why should I use an AI text to video generator instead of traditional video tools?\"},\"title\":\"FAQs about Text to Video Feature\"},\"feature\":{\"2DAnimation\":{\"description\":\"Vidu is a next-gen text to video solution, delivering beautifully stable visuals and natural character movements. As a powerful AI animation tool, it generates crisp, detailed frames that bring your ideas to life with cinematic clarity. Especially for 2D styles, Vidu is more than just a video generator — it's your creative animation partner.\",\"title\":\"Text to Video with Exceptional 2D Animation\"},\"lightningFast\":{\"description\":\"Create videos from text with AI text to video. Type what you want to see, like a scene, mood, or camera move, and the AI builds a full video with multiple shots, smooth motion, and sound like voices and music. It keeps scenes consistent and delivers a ready-to-use video in seconds.\",\"title\":\"Lightning-Fast Text to Video Generation\"},\"RealisticAnimation\":{\"description\":\"Enjoy smooth, lifelike animation in every frame. Vidu excels at generating natural body movements and camera dynamics, ensuring your text-to-video creations feel fluid and immersive. It's perfect for everything from character animations to cinematic sequences.\",\"title\":\"Natural Motion and Realistic Animation\"},\"Stunning\":{\"description\":\"Vidu elevates your video output with impressive visual quality. Our AI text to video generator captures fine details, realistic textures, and a strong sense of depth, transforming simple text into visually compelling video content. It's not just text to video, it's art in motion.\",\"title\":\"Stunning Visual Aesthetics in Text-to-Video Output\"}},\"promptFormula\":{\"items\":{\"action\":{\"description\":\"Say what is happening, like \\\"walking on the street\\\", \\\"driving fast\\\", or \\\"talking to the camera\\\". Clear actions make the video feel smooth.\",\"title\":\"Action\"},\"camera\":{\"description\":\"Choose how the shot looks, like \\\"close-up\\\", \\\"wide shot\\\", or \\\"slow pan\\\". You can also say how the camera moves, like \\\"follow from behind\\\".\",\"title\":\"Camera\"},\"scene\":{\"description\":\"Set the place, like \\\"sunset beach\\\", \\\"busy city street\\\", or \\\"modern office with soft light\\\". This helps the video feel real.\",\"title\":\"Scene\"},\"style\":{\"description\":\"Pick a style like \\\"cinematic\\\", \\\"anime\\\", or \\\"realistic\\\". You can also add mood like \\\"warm\\\", \\\"dark\\\" or \\\"soft light\\\".\",\"title\":\"Style\"},\"subject\":{\"description\":\"Pick who or what you want in the video, like \\\"a young woman\\\" or \\\"a red sports car\\\". Add small details like clothing, color, or style so it looks right.\",\"title\":\"Subject\"}},\"subtitle\":\"Turn any idea into a clear, structured prompt for better AI video results. Follow this simple formula to create more consistent, cinematic videos every time.\",\"title\":\"A Simple Prompt Formula\"},\"step\":{\"step1\":{\"description\":\"Click the Try Vidu button in the top right corner and select Text to Video. It's an easy way to try an AI text to video generator free and start creating right away. You can also click Explore or open the Template page to get ideas.\",\"title\":\"Choose Text to Video\"},\"step2\":{\"description\":\"Type your text prompt in the input box and describe what you want to see, like style or camera angles. A clear video from text prompt will give you better results.\",\"title\":\"Enter Text Prompt\"},\"step3\":{\"description\":\"Before you generate, adjust the settings. You can change style, number of videos, or aspect ratio. Then click Create to start.\",\"title\":\"Create a Video with Text\"},\"title\":\"How to Generate Video from Text\"},\"subtitle\":\"Turn your ideas into videos with AI text to video. Type your prompt, and get a complete video with smooth motion and consistent scenes. No editing. No retries.\",\"title\":\"AI Text to Video\"},\"api-platform\":\"API Platform\",\"app\":{\"cameraPermission\":\"No album access. Enable it in system settings.\"},\"blog\":{\"blog\":\"Vidu Blog\",\"breadcrumbs\":{\"blog\":\"Blog\",\"home\":\"Home\"},\"description\":\"Explore Vidu's blog for expert tips, trends, and tutorials on AI video creation. Stay updated on the latest in AI-driven video technology.\",\"noPosts\":\"No blog posts found.\",\"search\":{\"button\":\"Search\",\"placeholder\":\"Search here\"},\"section\":{\"latest\":\"Latest {title} Posts\"},\"slug\":{\"byAuthor\":\"by {author}\",\"conclusion\":\"Conclusion\",\"createButton\":{\"button\":\"Create Now\",\"description\":\"The best AI video generator delivering high-quality results in seconds.\"},\"readingTime\":\"{minutes} min read\",\"relatedArticles\":\"Related Articles\",\"tableOfContents\":\"Content\"},\"title\":\"Vidu Blog - Insights and Tips for AI Video Creation\",\"viewAll\":\"View all\"},\"bonusCode\":{\"dialog\":{\"error\":\"Invalid or expired promo code\",\"errorUserHasSubscriptions\":\"You've subscribed before and cannot claim the first-time subscription bonus again\",\"placeholder\":\"Enter the promo code\",\"submit\":\"Submit\",\"success\":\"Success\",\"title\":\"Promo Code\"},\"entry\":{\"label\":\"Promo code\",\"used\":\"Promo code in use {code}\"}},\"CharImgCropModal\":{\"description\":\"Image restrictions: Max size 50MB, min area 128×128, max aspect ratio 4:1\",\"title\":\"Photo Editing\"},\"claw\":{\"applyDialog\":{\"clawAlreadyActiveError\":\"Claw is already active. Please do not activate it again.\",\"clawCodeAlreadyBound\":\"ClawCode is already bound. Please do not bind it again.\",\"clawCodeInvalid\":\"ClawCode is invalid. Please enter a valid ClawCode\",\"clawInProgressError\":\"Claw is being created. Estimated time: 10 minutes. Please try again later.\",\"hint\":\"If you don't have a ClawCode, you can apply for it \u003cspan\u003ehere\u003c/span\u003e\",\"submitError\":\"Please enter a valid ClawCode\",\"title\":\"Please enter your ClawCode\",\"upgrade\":\"Or upgrade to ViduClaw \u003cspan\u003eUpgrade Now\u003c/span\u003e\"},\"assets\":{\"actions\":{\"delete\":\"Delete\",\"download\":\"Download\",\"downloadNoWatermark\":\"Download without watermark\",\"downloadWithWatermark\":\"Download with watermark\",\"insert\":\"Reference with @ in current input\",\"share\":\"Share\"},\"deleteConfirm\":\"Delete this asset from your claw?\",\"empty\":\"No assets yet\",\"emptyDescription\":\"Upload files or cre