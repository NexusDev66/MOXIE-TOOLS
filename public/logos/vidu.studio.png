 Pro / H.264 Pro\",\"expiresOn\":\"Expires on {date}\",\"fastSpeedRight\":\"Dedicated fast generation channel\",\"freeButton\":\"Free\",\"freeNotSupport\":\"Your plan has been upgraded to {Type} already. Switching plans is not supported.\",\"higherTierDesc\":\"If the current plans don't meet your needs, please contact us\",\"higherTierTitle\":\"On Demand\",\"highSpeedRight\":\"Dedicated high-speed generation channel\",\"hightPriority\":\"Free Off-Peak Mode: Submit up to 200 videos daily\",\"memberReadonlyTooltip\":\"Only team admins can purchase. Please contact your administrator.\",\"modeRight\":\"Generate up to 4 videos at once\",\"monthPeriod\":\"Monthly Billing\",\"newFeature\":\"Early feature access\",\"nextCycle\":\"Next month's renewal: {amount}\",\"nextPlan\":\"Next Plan\",\"nextPlanSupport\":\"You have changed your subscription\",\"notSupport\":\"Subscription change coming soon—stay tuned for updates!\",\"noWatermark\":\"Download without watermark\",\"off\":\"{num}% Off\",\"passButton\":\"Purchase Now\",\"per_monthly\":\"month\",\"per_quarterly\":\"quarter\",\"per_yearly\":\"year\",\"planDescription\":{\"premium_v2\":\"Balanced for efficiency and advanced capabilities\",\"standard_v2\":\"For everyday lightweight creation\",\"ultimate_v2\":\"For high-volume creation and complete benefits\"},\"proMode\":\"Prompt professional editing mode\",\"q2ImageUnlimited\":\"Unlimited Q2 1080p image generation\",\"q2ImageUnlimited_tooltip\":\"Text2image, Ref2image, Image Quick Edit\",\"qualityRight\":\"High-quality video generation\",\"referenceFreeRight\":\"{referenceNumber} references/month\",\"referenceRight\":\"Subject creation quota: {referenceNumber}/month\",\"savingsVsMonthly\":\"Save \u003camount\u003e\u003c/amount\u003e compared to monthly\",\"subscribeButton\":\"Subscribe Now\",\"subscriptionMonth\":\"Monthly Billing\",\"subscriptionQuarter\":\"Quarterly Billing\",\"subscriptionYear\":\"Yearly Billing\",\"team_account_manager_tips\":\"For payments of $40,000 and above\",\"team_benefit_account_manager\":\"Dedicated customer success manager\",\"team_benefit_assets\":\"Shared assets\",\"team_benefit_channel\":\"Dedicated enterprise generation channel\",\"team_benefit_commercial_use\":\"Generated content can be used commercially\",\"team_benefit_concurrent\":\"{concurrent} concurrent jobs\",\"team_benefit_credits\":\"Shared credits\",\"team_benefit_credits_share\":\"Team credit sharing\",\"team_benefit_custom\":\"Supports custom higher-tier plans\",\"team_benefit_discount\":\"Volume pricing up to 20% off\",\"team_benefit_events\":\"Enterprise-only events\",\"team_benefit_invoicing\":\"Bank transfer and invoicing\",\"team_benefit_manage\":\"Asset management / account management / project management\",\"team_benefit_new_feature\":\"Early access to new features\",\"team_benefit_q2_image_unlimited\":\"Q2 unlimited image generation\",\"team_benefit_seats\":\"Seats: from {seats} accounts\",\"team_benefit_solution\":\"Exclusive enterprise solutions\",\"team_benefit_subjects\":\"Create up to {subjects} subjects per month\",\"team_benefit_submission\":\"{submission} free video submissions per day\",\"team_benefit_support\":\"1-on-1 technical support\",\"team_benefit_training\":\"Employee training services\",\"team_training_tips\":\"Additional payment required\",\"teamBundleUnavailableReasonMembersExceedSeatLimit\":\"Team seats are full. Please contact your administrator to add more seats.\",\"teamBundleUnavailableReasonProductNotConfigured\":\"This plan is temporarily unavailable. Please try again later.\",\"teamBundleUnavailableReasonTeamNotExpired\":\"The current team plan has not expired yet. Repurchase is not available right now.\",\"teamLimit\":\"Start\",\"tierBasic\":\"Enterprise\",\"tierPlus\":\"Enterprise Plus\",\"tierPro\":\"Enterprise Pro\",\"title\":\"Subscription Plans\",\"titleAgentProject\":\"Upgrade to create\",\"titleClawProject\":\"Upgrade and start using ViduClaw\",\"ultraFastSpeedRight\":\"Dedicated ultra-fast generation channel\",\"unlimited365\":\"UNLIMITED\",\"upgradeButton\":\"Upgrade\",\"viewActivity\":\"View\",\"yearPeriod\":\"Yearly Billing\"},\"premium_v2\":\"Premium\",\"standard_v2\":\"Standard\",\"subscription\":\"Subscribe\",\"team_v2\":\"Team\",\"ultimate_v2\":\"Ultimate\",\"unspecified\":\"Free\",\"unsubscribe\":{\"cancel\":\"Cancel\",\"continue\":\"Continue\",\"description\":\"After unsubscribing, you will lose access to your current plan benefits. The subscription will expire on {date}. Are you sure you want to proceed?\",\"error\":\"Error: Failed to cancel subscription.\",\"success\":\"Success: Subscription cancelled.\",\"title\":\"Confirm Cancellation\"}},\"personal\":{\"accountInformation\":\"Account Information\",\"accountSetting\":\"Account Settings\",\"anon\":\"an\",\"avatar\":\"Avatar\",\"avatarDialog\":{\"cancel\":\"Cancel\",\"confirm\":\"Confirm\",\"edit\":\"Edit Image\",\"error\":\"Not approved. Please upload a new one.\",\"success\":\"success\"},\"basicInformation\":\"Basic Information\",\"bio\":{\"auditing\":\"Under review. Please do not resubmit\",\"dialogDescription\":\"Are you sure you want to save the changes?\",\"dialogTitle\":\"Save Bio\",\"error\":\"Not approved. Please upload a new one.\",\"formatError\":\"Bio must contain only letters, numbers, and special characters\",\"info\":\"Bio can be changed up to 3 times within 7 days.\",\"label\":\"Bio\",\"lengthError\":\"Bio is limited to 100 characters.\",\"note\":\"Please input 1-100 valid characters (English letters, hyphen, underscore, or numbers)\",\"requiredError\":\"Bio is required\",\"success\":\"successfully. Wait for review\"},\"delete\":{\"button\":\"Delete My Account\",\"description\":\"Deleting your account will have the following impacts. Please read carefully:  \u003cbr\u003e\u003c/br\u003e1. Upon deletion, you will immediately lose all subscription services (e.g., membership benefits, subscribed content), and they cannot be recovered.  \u003cbr\u003e\u003c/br\u003e2. Your account and all related data (e.g., personal information, videos) will be permanently deleted after a \u003cbold\u003e14-day\u003c/bold\u003e cooling-off period, and cannot be recovered.  \u003cbr\u003e\u003c/br\u003e3. During the \u003cbold\u003e14-day\u003c/bold\u003e cooling-off period, you can log in with your original account at any time to restore your data, and the deletion request will be automatically canceled.  \u003cbr\u003e\u003c/br\u003e4. If you do not log in within \u003cbold\u003e14 days\u003c/bold\u003e, your account and data will be permanently deleted.  \u003cbr\u003e\u003c/br\u003e5. Clicking the “Delete My Account” button will immediately initiate the account deletion process. Please decide with utmost caution!\",\"label\":\"Delete Account\"},\"edit\":\"Edit\",\"email\":{\"label\":\"Email\",\"note\":\"The email address used to sign up for Vidu.\"},\"feedback\":\"Feedback \u0026 Support\",\"freeCredits\":\"Earn point\",\"help\":\"Help Center\",\"logout\":\"Logout\",\"phone\":{\"label\":\"Phone\",\"note\":\"The phone number used to sign up for Vidu.\"},\"save\":\"Save\",\"subscribe\":\"My Subscription\",\"username\":{\"dialogDescription\":\"Are you sure you want to save the changes?\",\"dialogTitle\":\"Save Username\",\"error\":\"Not approved. Please upload a new one.\",\"formatError\":\"Username must contain only letters, numbers, and special characters\",\"info\":\"Username can be changed up to 3 times within 7 days.\",\"label\":\"Username\",\"lengthError\":\"Username needs to be between 4 and 30 characters.\",\"note\":\"Please input 4-30 valid characters (English letters, hyphen, underscore, or numbers)\",\"requiredError\":\"Username is required\",\"success\":\"Saved\"},\"version\":\"Version\"},\"popup\":{\"dialog\":{\"apiDialog\":{\"building\":\"Start Building\",\"description\":\"\u003cp\u003eDear Vidu Creators, \u003c/p\u003e\u003cp\u003eThe Vidu API is now live! With our fastest and most creative video generation model, endless possibilities await for your product development:\u003c/p\u003e\u003cul\u003e\u003cli\u003eSupports all models, including Vidu 2.0.\u003c/li\u003e\u003cli\u003eOffers a variety of specially optimized template APIs, including AI Hug, Valentine's Day effects, and more.\u003c/li\u003e\u003c/ul\u003e\",\"title\":\"Vidu \u003chighlight\u003eAPI\u003c/highlight\u003e Platform Officially Launched!\"},\"completedAdsDialog\":{\"button\":\"Got It\",\"description\":\"Awesome! You've got {count} credits — now go create something amazing!\"},\"delete\":{\"content\":\"Deleted records cannot be recovered.\",\"title\":\"Confirm Delete\"},\"deleteUser\":{\"cancel\":\"Cancel\",\"confirm\":\"Confirm Delete\",\"description\":\"Are you sure you want to delete your account? Please confirm the following:  \u003cbr\u003e\u003c/br\u003e1. Upon deletion, you will immediately lose all subscription services (e.g., membership benefits, subscribed content), and they cannot be recovered.  \u003cbr\u003e\u003c/br\u003e2. Your account and all related data will be permanently deleted after a \u003cbold\u003e14-day\u003c/bold\u003e cooling-off period, and cannot be recovered.  \u003cbr\u003e\u003c/br\u003e3. During the \u003cbold\u003e14-day\u003c/bold\u003e cooling-off period, you can log in with your original account at any time to cancel the deletion and restore your data.  \u003cbr\u003e\u003c/br\u003ePlease decide with utmost caution!\",\"title\":\"We are sorry to see you go :(\"},\"error\":{\"checkFailed\":{\"content\":\"The input content(text or image) may violate our content policy. Please revise and try again.\",\"title\":\"Review Failed\"},\"checkFailedExceeded\":{\"content\":\"Multiple violations of our content policy detected. Please try again {time}.\",\"title\":\"Failed to pass review\"},\"checkFailedExceededForSubs\":{\"content\":\"Multiple violations of our content policy detected.  If you continue to break the rules, your subscription will be cancelled, and you will be unable to use your remaining credits. Please try again {time}.\",\"title\":\"Failed to pass review\"},\"checkPlan\":\"Check Plans\",\"confirm\":\"Okay\",\"creditsInsufficient\":{\"content\":\"You've used all your monthly credits on this plan.\\nIt’s great to see you’ve enjoyed using our product and found it useful! Would you be open to considering an upgrade?\\n\\nHere’s what comes with an upgrade:\\n\u003cul\u003e\u003cli\u003eA lot more credits monthly\u003c/li\u003e\u003cli\u003eHigh-resolution video generation\u003c/li\u003e\u003cli\u003e8s video generation\u003c/li\u003e\u003cli\u003ePriority processing\u003c/li\u003e\u003cli\u003eNo more watermarks\u003c/li\u003e\u003c/ul\u003e\",\"title\":\"Credits Exhausted\"},\"creditsInsufficientForSubs\":{\"content\":\"Your credits are insufficient at the moment. Please purchase more credits.\",\"title\":\"Insufficient Credits\"},\"elementDeleted\":{\"content\":\"Reference deleted. Its information is no longer available.\",\"title\":\"Reference Deleted\"},\"extendCountExceeded\":{\"content\":\"The video cannot be extended for over 5 minutes.\",\"title\":\"Extend Limit Exceeded\"},\"fieldInvalid\":{\"content\":\"Please check your input and try again.\",\"title\":\"Invalid Input\"},\"freeTrialEnd\":{\"content\":\"Thank you for trying our 720p HD video generation model. Your trial opportunities have been used up. Ready to continue creating high-quality videos?\\n\\nUpgrade now and unlock these features:\\n\u003cul\u003e\u003cli\u003eHigh-resolution video generation\u003c/li\u003e\u003cli\u003e8s video creation\u003c/li\u003e\u003cli\u003ePriority processing\u003c/li\u003e\u003cli\u003e800+ monthly credits\u003c/li\u003e\u003cli\u003eNo watermarks\u003c/li\u003e\u003c/ul\u003e\",\"title\":\"Your Limited Trial Has Ended!\"},\"nonPeakTaskSubmitLimitExceeded\":{\"content\":\"You've reached today's Off-Peak submission limit of {limit} videos. Use credits to keep creating, or come back tomorrow. Ultimate members can buy credits at up to 56% off.\",\"title\":\"Notice\"},\"nonPeakTaskSubmitLimitExceededNoCoupon\":{\"content\":\"You've reached today's Off-Peak submission limit of {limit} videos. To keep generating, use credits now or simply come back tomorrow. Credits are available today at a limited-time discount!\",\"title\":\"Notice\"},\"openPayCreditsEntry\":\"Buy Credits \u0026 Save More\",\"SubsplanNotSupportedForTask\":{\"content\":\"{feature} video generation is not available in the free plan. Would you be open to considering an upgrade?\\n\\nHere’s what comes with an upgrade:\\n\u003cul\u003e\u003cli\u003e800+ credits monthly\u003c/li\u003e\u003cli\u003eHigh-resolution video generation\u003c/li\u003e\u003cli\u003e8s video generation\u003c/li\u003e\u003cli\u003ePriority processing\u003c/li\u003e\u003cli\u003eNo more watermarks\u003c/li\u003e\u003c/ul\u003e\",\"defaultFeature\":\"Advanced\",\"title\":\"Upgrade Needed\"},\"SubsplanNotSupportedForTaskForSubs\":{\"content\":\"{feature} video generation is not included in your current subscription plan.\",\"title\":\"Feature Not Included\"},\"system\":{\"content\":\"Our engineers are upgrading the system. Please try again later.\",\"title\":\"System Error\"},\"systemThrottling\":{\"content\":\"We’re growing faster than ever, and our servers are struggling to keep up. As a startup, we regret that continuing to add servers is not financially sustainable.\\n\\nTo skip the wait, you can subscribe to a paid plan. Here’s what you’ll get:\\n\u003cul\u003e\u003cli\u003eInstant generation\u003c/li\u003e\u003cli\u003e800+ credits monthly\u003c/li\u003e\u003cli\u003e8-second videos\u003c/li\u003e\u003cli\u003eNo more watermarks\u003c/li\u003e\u003c/ul\u003e\",\"title\":\"Server Overload for Free Users\"},\"systemThrottlingForSubs\":{\"content\":\"Sorry, the product is extremely popular, the server load has reached its limit. Please try again later.\",\"title\":\"Task Limit Exceeded\"},\"teamCreditsInsufficientContactAdmin\":{\"content\":\"Your team does not have enough credits. Please contact your workspace admin to purchase more credits.\",\"title\":\"Insufficient Credits\"},\"teamNeedUpgrade\":{\"content\":\"Your team needs to upgrade to create more projects. Please contact your workspace admin to upgrade.\",\"title\":\"Team Needs Upgrade\"},\"teamNonPeakTaskSubmitLimitExceeded\":{\"content\":\"Today's Off-Peak submission limit has been reached: {limit} videos. Please try again tomorrow or use credits to continue creating. To upgrade, please contact your enterprise account manager\",\"title\":\"Notice\"},\"unknownError\":{\"content\":\"An unknown error occurred. Please try again later.\",\"title\":\"Error\"}},\"feedback\":{\"cancel\":\"Cancel\",\"confirm\":\"Submit\",\"featureWishlist\":{\"aiMusicGeneration\":\"AI music generation\",\"title\":\"Feature Wishlist\",\"videoSoundtrack\":\"AI Video Soundtrack\",\"videoToAudio\":\"Video to Audio\"},\"issueFeedback\":{\"audioQuality\":\"Low audio quality(noise, distortion, etc.)\",\"audioTypes\":\"Limited audio types\",\"semanticUnderstanding\":\"Inaccurate semantic understanding\",\"timingControl\":\"Inaccurate timing control\",\"title\":\"Issue Feedback\"},\"optionInaccurate\":\"Inaccurate semantic understanding\",\"optionPoor\":\"Poor content quality\",\"optionUncomfortable\":\"The generated content makes people uncomfortable\",\"optionUnnatural\":\"Lack of stylistic diversity\",\"placeholder\":\"Please describe the issue. (You can click the button above for quick entry.)\",\"shareSuggestions\":\"Share your suggestions or needs, and we’ll carefully consider them!\",\"t2aTitle\":\"Your Feedback Matters\",\"title\":\"Feedback\"},\"getToken\":{\"copy\":\"Copy\",\"description\":\"To protect your account security, please do not disclose or share your Token on any public network or with others. \\n Vidu platform may automatically disable any leaked Tokens. Resetting will invalidate the previous Token immediately.\",\"reset\":\"Reset\",\"title\":\"Vidu TOKEN\"},\"googleAdsDialog\":{\"adsFailed\":\"We are experiencing a high volume of requests. Please try again later.\",\"credits\":\"{credits} credits\",\"earnIt\":\"Earn Credits\",\"noThanks\":\"No Thanks\",\"toEarnUpTo\":\"to earn up to\",\"watchAds\":\"Watch ads\"},\"insufficientCreditsAdsDialog\":{\"button\":\"Get Credits\",\"description\":\"Watch an ad to get the last credits you need to finish your video.\",\"noThanks\":\"No Thanks\",\"title\":\"Almost there—your video's nearly ready!\"},\"notifications\":{\"ok\":\"Got it\"},\"noWatermarkAdsDialog\":{\"button\":\"Save Without Watermark\",\"description\":\"Watch a short ad to save your AI-generated video clean and watermark-free.\",\"downloading\":\"Downloading watermark-free video…\",\"noThanks\":\"No Thanks\",\"title\":\"Want to download your video without a watermark?\"},\"posts\":{\"activityPostSuccess\":\"Successfully published, waiting for review\",\"addActivity\":\"Add activity\",\"cancel\":\"Cancel\",\"clickToUpload\":\"Click to upload your video\",\"confirm\":\"Confirm\",\"creations\":\"Creations\",\"detail\":\"Details\",\"error\":{\"activityNotAllowSubmit\":\"The activity is not allowed to publish. Please try again later.\",\"default\":\"Failed to publish content. Please try again later.\",\"workDuplicateSubmission\":\"You have already published this work. Please try again with a different work.\"},\"failed\":\"System failed. Please try again later.\",\"favorite\":\"Marked\",\"inspiration\":\"Inspirations\",\"inspirationPlaceholder\":\"Add a description\",\"inspirationTitle\":\"Introduce\",\"noActivityInProgress\":\"No activity in progress\",\"noReference\":\"No references created\",\"notAvailable\":\"No creations to publish at the moment\",\"notFavorite\":\"No Marked Content yet\",\"reference\":\"References\",\"referenceHistoryTip\":\"When enabled, others can save and edit this reference in their own libraries. When disabled, they can only use it from the community library but not modify it.\",\"rewardActivityPleaseSignUp\":\"Please sign up for the activit