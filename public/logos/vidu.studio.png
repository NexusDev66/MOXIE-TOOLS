ding AI templates\",\"title\":\"Vidu, AI Video Generator\"},\"shareContent\":{\"buttonElement\":\"Open Vidu to create videos\",\"buttonExplore\":\"Discover more in Vidu\",\"buttonRecreate\":\"Recreate this video in Vidu\",\"buttonRecreateImage\":\"Recreate this image in Vidu\",\"buttonTemplate\":\"Create Now\",\"detail\":\"More\",\"element\":{\"description\":\"Description\",\"introduction\":\"Introduction\",\"name\":\"Reference Name\",\"series\":\"Series\",\"style\":\"Style\",\"type\":\"Type\"},\"invite\":{\"award\":\"Sign Up for Vidu App and Create Your First Video\",\"description\":\"Discover More Magic\",\"download\":\"Download Vidu\"},\"moreTemplate\":\"More Amazing Templates\",\"prompt\":\"Prompt\",\"templateUsed\":\"Uses\",\"useCount\":\"Used\"}},\"header\":{\"navCpp\":\"CPP\",\"navCreate\":\"Create Video\",\"navCreations\":\"My Creations\",\"navCreativePartnerProgram\":\"Creative Partner Program\",\"navElements\":\"My References\",\"navHome\":\"Try Vidu\",\"navLogin\":\"Sign in\",\"tabs\":{\"api\":{\"label\":\"API Platform\"},\"community\":{\"label\":\"Join Community\",\"weChat\":\"Join WeChat\"},\"creatorPlan\":{\"label\":\"Creator Plan\",\"viduCash\":\"Vidu Cash\",\"viduCPP\":\"Vidu CPP\"},\"features\":{\"image\":\"Image to Video\",\"image-generator\":\"AI Image Generator\",\"label\":\"Features\",\"reference\":\"Reference to Video\",\"sound\":\"AI Sound Effect Generator\",\"text\":\"Text to Video\",\"vidu-claw\":\"Vidu Claw\",\"vidu-q3\":\"Vidu Q3\"},\"joinDiscord\":{\"label\":\"Join Discord\"},\"pricing\":{\"label\":\"Pricing\"},\"support\":{\"blog\":\"Blog\",\"helpCenter\":\"Help Center\",\"label\":\"Resources\",\"tutorial\":\"Tutorial\"},\"templates\":{\"label\":\"Templates\"}}},\"helpCenter\":{\"answer\":\"Get your questions answered?\",\"connectOnDiscord\":\"Connect on Discord\",\"contact\":{\"content1\":\"Please reach out to \",\"content2\":\" for further assistance.\"},\"stillNeedHelp\":\"Still need help?\",\"title\":\"Vidu Help Center\"},\"home\":{\"create_entry\":{\"image\":{\"button\":\"Try Now\",\"description\":\"Bring Image to Life in 20s\",\"title\":\"Image to Video\"},\"reference\":{\"button\":\"Try Now\",\"description\":\"Everything is Composable\",\"title\":\"Reference to Video\"}},\"explore\":{\"empty\":\"Nothing to show here... yet!\",\"promptButton\":\"Recreate\",\"reachedBottom\":\"You've reached the end\",\"templateButton\":\"Use Template\",\"title\":\"Explore\"},\"inspiration\":{\"title\":\"Inspiration\"},\"more\":\"More\",\"quickEntries\":{\"faceSwap\":{\"title\":\"AI Face Swap\"},\"img2video\":{\"title\":\"Image to Video\"},\"reference\":{\"title\":\"Reference\"},\"templates\":{\"title\":\"AI Templates\"},\"videoRemake\":{\"title\":\"AI Video Remaker\"}},\"shareReference\":{\"rankTip\":\"Ranking\"},\"short_film\":{\"title\":\"Short Films\"},\"submit\":\"Publish\",\"templates\":{\"title\":\"Templates\"},\"tutorials\":{\"title\":\"Tutorials\"}},\"home3\":{\"aiTemplate\":{\"description\":\"Use Vidu's templates to create fun, viral videos—whether it's kissing, hugging, blossom effects, AI outfits, and more.\",\"exploreMore\":\"Create Now\",\"title\":\"Templates for Everyone\"},\"creators\":{\"subTitle\":\"About Vidu AI Video Generator\",\"title\":\"What Do Creators Say\"},\"footer\":{\"button\":\"Try it now\",\"buttonTip\":\"Free Your Creativity\",\"company\":{\"about\":\"About Us\",\"contact\":\"Contact Us: support@vidu.com\",\"creative\":\"Creative Partner Program\",\"title\":\"COMPANY\"},\"cookiesPolicy\":\"Cookies Policy\",\"enterprise\":{\"api\":\"API Platform\",\"title\":\"For Enterprise\"},\"function\":{\"all-tools\":\"All Tools\",\"image\":\"Image to Video\",\"image-generator\":\"AI Image Generator\",\"reference\":\"Reference to Video\",\"sound\":\"AI Sound Effect Generator\",\"templates\":\"Templates\",\"text\":\"Text to Video\",\"title\":\"GET STARTED\",\"vidu-q3\":\"Vidu Q3\"},\"personalInfoCollection\":\"Info Collection List\",\"personalInfoSharing\":\"Info Sharing List\",\"privacy\":\"Privacy Policy\",\"privacyPolicy\":\"Privacy Policy\",\"privacySummary\":\"Privacy Summary\",\"serviceTerms\":\"Service Terms\",\"support\":{\"help\":\"Help Center\",\"title\":\"Support\",\"tutorial\":\"Tutorials\"},\"terms\":\"Terms of Use\",\"title\":\"What you imagine is what Vidu.\",\"tools\":{\"ai-ad-generator\":\"AI Video Ad Generator\",\"ai-animation-generator\":\"AI Animation Generator\",\"ai-dance-generator\":\"AI Dance Generator\",\"ai-hug-generator\":\"AI Hug Generator\",\"ai-image-animator\":\"AI Image Animator\",\"ai-image-to-video-generator\":\"Image to Video AI Generator\",\"ai-kissing-generator\":\"AI Kissing Generator\",\"ai-text-to-video-generator\":\"Text to Video AI Generator\",\"ai-tiktok-video-generator\":\"AI TikTok Video Generator\",\"ai-video-generator\":\"AI Video Generator\",\"title\":\"AI TOOLS\",\"viewAll\":\"View All\"}},\"heroSection\":{\"android\":\"Andriod\",\"createButton\":\"Create\",\"description\":\"Experience advanced comprehension, cinematic visuals, smooth 24fps motion, and the ability to generate 5-second videos.\",\"ios\":\"ios\",\"navHome\":\"Try Vidu\",\"navLogin\":\"Sign in\",\"release\":\"New Release\",\"slogan\":\"What you imagine is what Vidu\",\"subSlogan\":\"All-in-one AI image \u0026 video creation — fast, high-quality, and affordable\",\"viduQ1\":\"Vidu Q1\"},\"joinOur\":{\"applyForCPP\":\"Apply for CPP\",\"description\":\"Millions of anime fans, AI video creators, and short video makers use Vidu. Join the Vidu community to explore more creations and get inspired by others.\",\"joinDiscord\":\"Join Discord\",\"joinWechat\":\"加入微信群\",\"subTitle\":\"Community\",\"title\":\"Join Our\"},\"newsletter\":{\"button\":\"Subscribe\",\"completeButton\":\"Complete\",\"description\":\"Join our newsletter for product updates, tips, and special offers.\",\"dialog\":{\"agreeToTermsText\":\"By subscribing, I agree that I want to receive emails from \u003cstrong\u003eVidu\u003c/strong\u003e about updates, tips, special offers, upcoming events and services that I may find interesting. I can withdraw this consent at any time as described in the \u003cprivacy\u003ePrivacy Policy\u003c/privacy\u003e or by clicking on the \\\"unsubscribe\\\" link in the email.\",\"emailLabel\":\"Email:\",\"emailPlaceholder\":\"Your Email...\",\"errors\":{\"emailInvalid\":\"Please enter the correct email address\",\"emailRequired\":\"Email is required\",\"firstNameRequired\":\"First name is required\",\"lastNameRequired\":\"Last name is required\",\"termsRequired\":\"You must agree to receive emails to subscribe\"},\"firstNameLabel\":\"First Name\",\"firstNamePlaceholder\":\"Your First Name...\",\"lastNameLabel\":\"Last Name\",\"lastNamePlaceholder\":\"Your Last Name...\",\"privacyPolicyLink\":\"Privacy Policy\",\"title\":\"Sign up to receive exclusive\\n updates and content\"},\"login\":{\"credits\":\"20 credits have been added to your account—welcome!\",\"description\":\"You're all set. You'll receive the latest updates and offers from us.\",\"title\":\"Thanks for Subscribing\"},\"placeholder\":\"Your email address\",\"subTitle\":\"Get 20 Free Credits — Subscribe Now\",\"title\":\"Newsletter\",\"unlogin\":{\"description\":\"You're on the list! Stay tuned for the latest news, product updates, and special offers.\",\"title\":\"Thanks for Subscribing\"}},\"questions\":{\"answer1\":{\"item1\":\"Vidu is a cutting-edge AI video generator that transforms text and images into high-quality videos, supporting multiple creation modes: Text to Video, Image to Video, and Reference to Video. Designed for independent creators and teams, Vidu simplifies the production of high-quality videos, 2D animations, and diverse artistic styles, empowering users to bring their creative visions to life effortlessly.\",\"item2\":\"With robust semantic understanding and fast generation speed, Vidu eliminates production complexities, allowing creators to focus solely on their ideas. From low resolution to stunning 1080p outputs, Vidu offers unmatched flexibility and efficiency, providing a broader canvas for creativity.\"},\"answer2\":{\"item1\":\"Vidu AI is a powerful tool for creating high-quality AI-generated videos with exceptional consistency and fast generation speed. It is widely used across various industries, from social media content creation to professional video production and commercial advertising. \",\"item2\":\"Many creators use Vidu AI to produce viral videos like kissing, hugging, or fighting clips.\",\"item3\":\"Film studios and animation teams leverage it for studio-level 2D animations and cinematic content. \",\"item4\":\"Businesses also use Vidu AI to enhance marketing videos, such as image-to-video to animate product images or reference-to-video to change ad backgrounds, making video advertisements more dynamic and engaging.\",\"item5\":\"With its advanced AI capabilities, Vidu AI streamlines video production for creators, studios, and businesses.\"},\"answer3\":{\"item1\":\"Image to Video:\",\"item2\":\"Vidu's Image-to-Video feature allows users to create AI-generated videos from a static image, bringing them to life with motion and animation. Users can also set the first and last frames of their AI video. It streamlines the video or animation creation process—often leading to surprising and creative results.\",\"item3\":\"Reference to Video:\",\"item4\":\"Reference to Video lets users upload three or more images of an object, character, or scene as references, and Vidu can combine elements into a seamless video based on a prompt. Vidu's Reference to Video also supports uploading different angles of a character or object to ensure consistency. Vidu also offers the My References feature, allowing users to save characters, props, and scenes for effortless reuse, enhancing both creative efficiency and video quality. This feature is ideal for maintaining consistency and seamlessly generating videos that blend multiple visual references.\"},\"answer4\":{\"item1\":\"All users receive a set amount of free credits to generate videos at no cost.\"},\"answer5\":{\"item1\":\"Yes, Vidu AI is completely safe to use. We prioritize user data security and privacy, ensuring all uploaded content remains confidential. Vidu does not share or leak personal information. Our system is designed with robust security measures to protect your data at all times.  For more details on how we handle your information, please refer to our Terms of Use.\"},\"answer6\":{\"item1\":\"If you have additional questions about Vidu, you can:\",\"item2\":\"Join our Discord community at \u003clink\u003ehttps://discord.gg/3pDU8fmQ8Y\u003c/link\u003e to connect with our team and other users for real-time support and updates.\",\"item3\":\"Visit our \u003cspan\u003eHelp Center\u003c/span\u003e for answers and support.\"},\"description\":\"Find answers to common questions about Vidu AI, including its features, usage, pricing, safety, and how to get support.\",\"question1\":\"What is Vidu?\",\"question2\":\"What is the use of Vidu AI?\",\"question3\":\"What's the difference between Vidu's Reference to Video and Image to Video?\",\"question4\":\"Is Vidu AI free to use?\",\"question5\":\"Is Vidu AI safe to use?\",\"question6\":\"How can I reach out if I have more questions about Vidu?\",\"title\":\"Frequently Asked Questions\"},\"scene\":{\"advertising\":\"Advertising\",\"anime\":\"Anime\",\"cultureTourism\":\"Culture \u0026 Tourism\",\"film\":\"Film\",\"graphicDesign\":\"Graphic Design\",\"socialMedia\":\"Social Media\",\"title\":\"Use Vidu AI Video Generator for\"},\"viduAbility\":{\"claw\":{\"description\":\"Anyone can turn ideas into marketing content with ViduClaw.\",\"title\":\"Vidu Claw\"},\"image\":{\"animeArt\":\"Anime Art to Video\",\"animeArtDesc\":\"Transform anime art into fluid animations with lifelike character motions.\",\"button\":\"Get Started\",\"description\":\"Bring still images to life with dynamic motion that aligns with your vision.\",\"setFirst\":\"First \u0026 Last Frames Control\",\"setFirstReDesc\":\"Upload the first and last frame images, and Vidu AI will create smooth transitions in between.\",\"title\":\"Image to Video\"},\"reference\":{\"button\":\"Coming Soon\",\"button2\":\"Get Started\",\"description\":\"Create videos that align with reference subjects, such as characters, objects, and scenes. \",\"mltReDesc\":\"Keep people, objects, and scenes consistent throughout your video by uploading up to 7 images.\",\"multiReference\":\"Multi-Reference Consistency\",\"themeLibrary\":\"My References\",\"themeLibraryDesc\":\"Save characters, props, and scenes in My References for effortless reuse.\",\"title\":\"Reference to Video\"}},\"whyVidu\":{\"creation\":\"Creation\",\"credits\":\"Generation\",\"creditsDesc\":\"Enjoy unlimited free video creation in Off-Peak Mode—no credits required.\",\"description\":\"Vidu AI Video Generator delivers what others can't - trusted by millions worldwide.\",\"generation\":\"Generation\",\"generationDesc\":\"Create high-quality anime videos with natural character animation.\",\"instant\":\"Instant Video\",\"instantDesc\":\"Generate videos in just 10 seconds—fast, effortless, and efficient.\",\"superiorAnime\":\"Superior Anime\",\"title\":\"Why Vidu AI Video Generator?\",\"unlimitedFree\":\"Unlimited Free\"}},\"homeTab\":{\"activity\":\"Activities\",\"all\":\"All\",\"cases\":\"Cases\",\"latest\":\"New\",\"mediaAsset\":\"Inspirations\",\"recommended\":\"Recommendations\",\"sharedReferences\":\"RefHub\",\"shortFilm\":\"Short Films\",\"tutorial\":\"Tutorials\"},\"img2VideoImgCropModal\":{\"descriptionNew\":\"Keep aspect ratios of all images consistent (difference \u003c1.25) for best video results\\nImage restrictions: Max size 50MB, min area 128×128, max aspect ratio 4:1\",\"first\":\"First\",\"last\":\"Last\",\"title\":\"Photo Editing\"},\"imgCropModal\":{\"deleteLast\":{\"cancel\":\"Cancel\",\"confirm\":\"Delete and Exit\",\"content\":\"Deleting the last image will exit the cropping mode.\",\"res